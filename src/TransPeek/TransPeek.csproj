<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TransPeek</RootNamespace>
    <AssemblyName>TransPeek</AssemblyName>
    <!-- Version shown in Settings > About and used for the release-notes
         link (releases/tag/v0.1.0). Bump per release. -->
    <Version>0.1.0</Version>
    <!-- ScreenCaptureService uses an unsafe block to copy D3D frame rows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (no MSIX) for v0.1: Manh runs the exe directly.
         Self-contained Windows App SDK runtime ships with the app, so no
         separate runtime installer is needed. Packaged/MSIX comes at
         release time (see docs/DECISIONS.md). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Keep MSIX tooling on even though the app is unpackaged: these
         targets generate resources.pri (compiled XAML) into the publish
         output. With WindowsPackageType=None the SDK turns them off by
         default, and dotnet publish then ships no PRI at all. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
    <!-- WinUI 3 apps are single-project; the appxmanifest below is kept
         minimal (identity only) because the app is unpackaged. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 1.8.12 (NuGet version 1.8.260921001). 1.x line,
         latest stable in that line; 2.x exists but changes packaging
         (metapackage refactor) — upgrade is a deliberate follow-up. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- Tray icon for WinUI 3 (H.NotifyIcon 2.3.2, MIT). WinUI has no
         built-in NotifyIcon; this is the standard community control. -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <!-- UI Automation (TextPattern.GetSelection) for the selected text. -->
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- Direct3D 11 for the GraphicsCapture path (Vortice 3.8.3). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransPeek.Core\TransPeek.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <!-- App.xaml is picked up as ApplicationDefinition by the SDK's
         default globs; listing it explicitly duplicates the item and
         breaks the build (XamlCompiler WMC1012, CI run 42430004573). -->
  </ItemGroup>

  <!-- Unpackaged publish fix (WinUI 3 startup crash 0xC000027B):
       dotnet publish with WindowsPackageType=None does not copy the
       app's compiled XAML (.xbf) or its resource index (.pri) into the
       publish folder. Without them the shipped exe cannot load
       App.xaml's resources and dies at startup inside
       Microsoft.UI.Xaml.dll (STATUS_STOWED_EXCEPTION). Copy them from
       the build output after publish. The .pri is copied under both
       its build name and the runtime-expected name resources.pri. -->
  <Target Name="CopyWinUIPublishOutputs" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_WinUIXbfFiles Include="$(OutDir)*.xbf" />
      <_WinUIPriFile Include="$(OutDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIXbfFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPriFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPriFile)" DestinationFiles="$(PublishDir)resources.pri" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="WinUI publish outputs copied: @(_WinUIXbfFiles); @(_WinUIPriFile)" />
  </Target>

  <!-- No binary assets in v0.1 (the connector cannot push binaries, and
       the app icon is a follow-up — see docs/DECISIONS.md). The tray icon
       is an embedded base64 PNG (Assets/EmbeddedIcon.cs). -->
</Project>
