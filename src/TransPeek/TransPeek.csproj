<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TransPeek</RootNamespace>
    <AssemblyName>TransPeek</AssemblyName>
    <!-- App icon for TransPeek.exe (Manh 2026-11-14): the .ico is the
         same artwork as the tray icon (EmbeddedIcon.cs base64, decoded
         to Assets/TransPeek.ico — the connector cannot push binary
         files, so the .ico itself was uploaded via the browser). -->
    <ApplicationIcon>Assets\TransPeek.ico</ApplicationIcon>
    <!-- Version shown in Settings > About and in the tray menu header
         (AppInfo.Version reads the assembly version). Bump per release —
         keep in step with Package.appxmanifest, which the manifest-only
         bump to 0.1.3.0 forgot: About showed 0.1.0 until this fix. -->
    <Version>0.1.3</Version>
    <!-- ScreenCaptureService uses an unsafe block to copy D3D frame rows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (no MSIX) for v0.1: Manh runs the exe directly.
         Self-contained Windows App SDK runtime ships with the app, so no
         separate runtime installer is needed. Packaged/MSIX comes at
         release time (see docs/DECISIONS.md). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- NOTE: do NOT set EnableMsixTooling=true here. It activates the
         MSIX packaging targets, which fail the build with "Improper
         project configuration: WindowsPackageType is set to None, but a
         AppxManifest is specified" (CI runs #19/#20). The .pri/.xbf
         gap is handled by the CopyWinUIPublishOutputs target below. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>x64</Platforms>
    <!-- WinUI 3 apps are single-project; the appxmanifest below is kept
         minimal (identity only) because the app is unpackaged. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK 1.8.12 (NuGet version 1.8.260921001). 1.x line,
         latest stable in that line; 2.x exists but changes packaging
         (metapackage refactor) — upgrade is a deliberate follow-up. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <!-- Tray icon for WinUI 3 (H.NotifyIcon 2.3.2, MIT). WinUI has no
         built-in NotifyIcon; this is the standard community control. -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <!-- System.Drawing for the tray icon handle (TrayIconService builds
         a System.Drawing.Icon from the embedded PNG). Floor is 9.0.1:
         H.NotifyIcon needs >= 9.0.1 and FlaUI needs >= 8.0.10 — a
         direct reference BELOW those floors caused NU1605 downgrade
         errors (runs #31/#32), so never pin lower. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.1" />
    <!-- UI Automation (TextPattern.GetSelection) for the selected text. -->
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <!-- Direct3D 11 for the GraphicsCapture path (Vortice 3.8.3). -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- Barcode/QR decoding for the tray menu (ZXing.Net 0.16.9, Apache
         2.0). Decoding uses the WinRT BitmapDecoder + ZXing's
         RGBLuminanceSource, so this project needs NO direct
         System.Drawing.Common reference: adding one pinned below the
         transitive versions caused NU1605 downgrade errors (runs #31:
         FlaUI needs >= 8.0.10; #32: H.NotifyIcon needs >= 9.0.1).
         Without a direct reference NuGet takes the highest transitive
         version and the downgrade disappears. -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TransPeek.Core\TransPeek.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest" />
    <!-- App.xaml is picked up as ApplicationDefinition by the SDK's
         default globs; listing it explicitly duplicates the item and
         breaks the build (XamlCompiler WMC1012, CI run 42430004573). -->
  </ItemGroup>

  <ItemGroup>
    <!-- Donate card ("Buy me a coffee", Manh 2026-11-12): the full
         BIDV VietQR card, shipped as Content next to the exe and
         loaded from the file path (ms-appx as fallback). Binary asset —
         pushed via the browser (the connector cannot push binaries);
         the app icon stays base64 in Assets/EmbeddedIcon.cs.
         CopyToOutputDirectory is REQUIRED: without it the file never
         reached the publish folder, so the QR dialog showed text only
         (0.1.3.59 test). -->
    <Content Include="Assets\DonateCard.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Unpackaged publish fix (WinUI 3 startup crash 0xC000027B):
       dotnet publish with WindowsPackageType=None does not copy the
       app's compiled XAML (.xbf) or its resource index (.pri) into the
       publish folder. Without them the shipped exe cannot load
       App.xaml's resources and dies at startup inside
       Microsoft.UI.Xaml.dll (STATUS_STOWED_EXCEPTION). Copy them from
       the build output after publish. The .pri is copied under both
       its build name and the runtime-expected name resources.pri.
       NOTE: only App.xbf lands flat in OutDir; the pages' .xbf files
       may sit in OutDir subfolders or only in the intermediate output
       (obj), so search all of them. The PRI references every .xbf by
       bare filename, so copy them flat into the publish folder. -->
  <Target Name="CopyWinUIPublishOutputs" AfterTargets="Publish" Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_WinUIXbfFiles Include="$(OutDir)**\*.xbf" />
      <_WinUIXbfFiles Include="$(MSBuildProjectDirectory)\obj\**\*.xbf" />
      <_WinUIPriFile Include="$(OutDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIXbfFiles)" DestinationFiles="@(_WinUIXbfFiles->'$(PublishDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPriFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIPriFile)" DestinationFiles="$(PublishDir)resources.pri" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="WinUI publish outputs copied: @(_WinUIXbfFiles); @(_WinUIPriFile)" />
  </Target>

  <!-- Binary assets: only Assets/DonateCard.png (see the Content item
       above); the app icon stays base64 in Assets/EmbeddedIcon.cs. -->
</Project>
