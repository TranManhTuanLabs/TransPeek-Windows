<Window
    x:Class="TransPeek.FastRead.FastReadWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fast Read (RSVP) reader window — feature/fast-read-rsvp.
         A SEPARATE window, not a panel tab: RSVP needs a big word
         (50-110 pt), one fixed focal point, a progress bar and a pause
         context — none of that fits the 420 px translate panel.
         UX copies SwiftRead's reader (rsvp-report.md §6.1): one word
         at a time at a fixed ORP pivot (middle char, orange #F6861F),
         context +/-150 words on pause, WPM 275 default, chunk 1-6.
         READ ONLY — no TTS in the reader (listening is the float
         icon's job). Controls: Space play/pause, Left/Right step a
         slide, Up/Down WPM +/-10, R restart, Esc/Q close. -->
    <Grid x:Name="RootGrid" Padding="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Word area: focal ticks above/below, the word centered on
             its ORP pivot (code shifts it with a TranslateTransform so
             the pivot char sits exactly at the center). -->
        <Grid x:Name="WordArea" Grid.Row="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Rectangle Width="2" Height="16" Fill="#C8C8C8" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="WordTextBlock" FontSize="110" TextAlignment="Center">
                    <Run x:Name="LeftRun" /><Run x:Name="PivotRun" Foreground="#F6861F" /><Run x:Name="RightRun" />
                </TextBlock>
                <Rectangle Width="2" Height="16" Fill="#C8C8C8" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- Pause context: +/-150 words around the current slide, the
             current words bold + orange. Shown only while paused. -->
        <ScrollViewer x:Name="ContextScroller" Grid.Row="1" MaxHeight="120"
                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock x:Name="ContextTextBlock" TextWrapping="Wrap" FontSize="16" LineHeight="24" />
        </ScrollViewer>

        <!-- Progress: seek slider + status (slide x/y, time left). -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="ProgressSlider" Minimum="0" ValueChanged="OnProgressChanged" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="13" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- Controls: play/pause, restart, WPM, chunk, font size. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="PlayPauseButton" Padding="10,6" Click="OnPlayPauseClicked" ToolTipService.ToolTip="Play / Pause (Space)">
                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" />
            </Button>
            <Button x:Name="RestartButton" Padding="10,6" Click="OnRestartClicked" ToolTipService.ToolTip="Restart from the beginning (R)">
                <FontIcon Glyph="&#xE72C;" FontSize="16" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Speed" FontSize="13" VerticalAlignment="Center" />
                <Slider x:Name="WpmSlider" Width="160" Minimum="100" Maximum="2000" StepFrequency="25" ValueChanged="OnWpmChanged" VerticalAlignment="Center" />
                <TextBlock x:Name="WpmText" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Words" FontSize="13" VerticalAlignment="Center" />
                <ComboBox x:Name="ChunkCombo" SelectionChanged="OnChunkChanged" VerticalAlignment="Center">
                    <ComboBoxItem Content="1" Tag="1" />
                    <ComboBoxItem Content="2" Tag="2" />
                    <ComboBoxItem Content="3" Tag="3" />
                    <ComboBoxItem Content="4" Tag="4" />
                    <ComboBoxItem Content="5" Tag="5" />
                    <ComboBoxItem Content="6" Tag="6" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Size" FontSize="13" VerticalAlignment="Center" />
                <Slider x:Name="FontSlider" Width="120" Minimum="50" Maximum="110" StepFrequency="2" ValueChanged="OnFontSizeChanged" VerticalAlignment="Center" />
                <TextBlock x:Name="FontText" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
