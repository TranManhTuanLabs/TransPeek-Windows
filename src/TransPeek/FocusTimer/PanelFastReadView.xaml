<UserControl
    x:Class="TransPeek.FocusTimer.PanelFastReadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TransPeek.FocusTimer">

    <!-- Panel right — Fast Read lite (feature/focus-timer-decor, mac
         parity: PanelFastReadView.swift): the demo when nothing reads,
         the CompactReadingView while reading. The demo shows the word
         "reading" with its "a" in yellow between two half-bars (the
         pivot preview, like mac's FocusDemoView), a "Read in panel"
         button, and the "Run FastRead in:" radios (FastRead Lite /
         New FastRead Window, default Window — applies to every Fast
         Read entry: panel button, float icon, tray, shortcut). The
         "Read in panel" button ALWAYS reads in the panel, whatever
         the radios say. While reading, a reminder countdown ("Rest —
         mm:ss" + Done) shows below the reader when a reminder read
         finishes. -->
    <Grid>
        <!-- Demo -->
        <StackPanel x:Name="DemoGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="16,0">
            <FontIcon Glyph="&#xE736;" FontSize="32" Foreground="Gray" HorizontalAlignment="Center" />
            <TextBlock Text="Fast Read Lite" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="Try the focus preview below, or read the current text in this panel."
                       FontSize="12" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <!-- Focus preview: "reading" with the "a" in yellow, a
                 half-bar above and below centered on the "a" (the
                 bars are 24 wide, 2 tall, like mac's FocusDemoView;
                 the word is shifted so the "a" sits exactly at the
                 center, like the reader's AlignPivot). -->
            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                <Rectangle Width="24" Height="2" Fill="#C8C8C8" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="DemoWordTextBlock" FontSize="40" TextAlignment="Center">
                    <Run Text="re" /><Run Text="a" Foreground="#FFD60A" /><Run Text="ding" />
                </TextBlock>
                <Rectangle Width="24" Height="2" Fill="#C8C8C8" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
            <Button x:Name="ReadInPanelButton" Content="Read in panel" Click="OnReadInPanelClicked"
                    HorizontalAlignment="Center" Margin="0,12,0,0" />
            <!-- "Run FastRead in:" is LEFT-aligned (Manh 2026-11-20),
                 like mac — the rest of the demo stays centered. -->
            <StackPanel Margin="0,12,0,0" Spacing="4" HorizontalAlignment="Left">
                <TextBlock Text="Run FastRead in:" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left" />
                <RadioButton x:Name="RunInPanelRadio" Content="FastRead Lite" GroupName="RunFastReadIn"
                             HorizontalAlignment="Left" Checked="OnRunLocationChecked" />
                <RadioButton x:Name="RunInWindowRadio" Content="New FastRead Window (recommended)" GroupName="RunFastReadIn"
                             HorizontalAlignment="Left" Checked="OnRunLocationChecked" />
                <TextBlock Text="Applies to the Fast Read button, the float icon, and the keyboard shortcut."
                           FontSize="12" Foreground="Gray" HorizontalAlignment="Left" TextWrapping="Wrap" TextAlignment="Left" />
            </StackPanel>
        </StackPanel>

        <!-- Reading -->
        <Grid x:Name="ReadingGrid" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <local:CompactReadingView x:Name="CompactView" Grid.Row="0" />
            <!-- Reminder countdown after a reminder read finishes
                 (mac: "Rest — mm:ss" + Done below the reader). -->
            <StackPanel x:Name="CountdownGrid" Grid.Row="1" Orientation="Horizontal" Spacing="12"
                        HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock x:Name="CountdownText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Done" Click="OnCountdownDoneClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
