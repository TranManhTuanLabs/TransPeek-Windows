<UserControl
    x:Class="TransPeek.FocusTimer.PanelFastReadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TransPeek.FocusTimer">

    <!-- Panel right — Fast Read lite (feature/focus-timer-decor, mac
         parity: PanelFastReadView.swift): the demo when nothing reads,
         the CompactReadingView while reading. The demo shows the word
         "reading" with its "a" in yellow between two half-bars (the
         pivot preview, like mac's FocusDemoView), a "Read in panel"
         button, and the "Run FastRead in:" radios (FastRead Lite /
         FastRead Full Window, default Window — applies to every Fast
         Read entry: panel button, float icon, tray, shortcut). The
         "Read in panel" button ALWAYS reads in the panel, whatever
         the radios say. When a reminder read finishes, the reader
         pivot preview, like mac's FocusDemoView), a "Read in:" row
         (FastRead Lite / FastRead Full Window buttons — read this
         text right now, bypassing the setting below), and the "Run
         FastRead in:" radios (FastRead Lite / FastRead Full Window,
         default Window — the default for later entries: float icon,
         tray, shortcut, reminder). The "Read in:" buttons ALWAYS read
         where they say, whatever the radios say. When a reminder read
         finishes, the reader
         hides and a coffee countdown screen (like the Rest window)
         shows in the middle: Cafe icon + title + big mm:ss + Done. -->
    <Grid>
        <!-- Demo — scrollable (Manh 2026-11-27): the demo content
             (preview + "Read in:" + "Run FastRead in:") can be taller
             than the panel, so it scrolls instead of being cut off. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="DemoGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="16,12">
            <FontIcon Glyph="&#xE736;" FontSize="32" Foreground="Gray" HorizontalAlignment="Center" />
            <TextBlock Text="Fast Read Lite" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="Try the focus preview below, or read the current text in this panel."
                       FontSize="12" Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <!-- Focus preview: "reading" with the "a" in yellow, a
                 half-bar above and below centered on the "a" (the
                 bars are 24 wide, 2 tall, like mac's FocusDemoView;
                 the word is shifted so the "a" sits exactly at the
                 center, like the reader's AlignPivot). -->
            <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                <Rectangle Width="24" Height="2" Fill="#C8C8C8" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="DemoWordTextBlock" FontSize="40" TextAlignment="Center">
                    <Run Text="re" /><Run Text="a" Foreground="#FFD60A" /><Run Text="ding" />
                </TextBlock>
                <Rectangle Width="24" Height="2" Fill="#C8C8C8" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
            <!-- "Read in:" is LEFT-aligned (like "Run FastRead in:"
                 below, Manh 2026-11-22, mac parity): read THIS text
                 right now — the two buttons name only the destination
                 ("Read in" is already in the title). Both bypass the
                 "Run FastRead in:" setting below. -->
            <StackPanel Margin="0,12,0,0" Spacing="4" HorizontalAlignment="Left">
                <TextBlock Text="Read in:" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                    <Button x:Name="ReadInPanelButton" Content="FastRead Lite" Click="OnReadInPanelClicked" />
                    <Button x:Name="ReadInWindowButton" Content="FastRead Full Window" Click="OnReadInWindowClicked" />
                </StackPanel>
            </StackPanel>
            <!-- "Run FastRead in:" is LEFT-aligned (Manh 2026-11-20),
                 like mac — the rest of the demo stays centered. -->
            <StackPanel Margin="0,12,0,0" Spacing="4" HorizontalAlignment="Left">
                <TextBlock Text="Run FastRead in:" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Left" />
                <RadioButton x:Name="RunInPanelRadio" Content="FastRead Lite" GroupName="RunFastReadIn"
                             HorizontalAlignment="Left" Checked="OnRunLocationChecked" />
                <RadioButton x:Name="RunInWindowRadio" Content="FastRead Full Window (recommended)" GroupName="RunFastReadIn"
                             HorizontalAlignment="Left" Checked="OnRunLocationChecked" />
                <TextBlock Text="Applies to the Fast Read button, the float icon, and the keyboard shortcut."
                           FontSize="12" Foreground="Gray" HorizontalAlignment="Left" TextWrapping="Wrap" TextAlignment="Left" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- Reading -->
        <Grid x:Name="ReadingGrid" Visibility="Collapsed">
            <local:CompactReadingView x:Name="CompactView" />
            <!-- Countdown after a reminder read finishes (Manh
                 2026-11-20 18:19): same screen as the Rest window —
                 coffee cup (Cafe EC32) + title + big mm:ss + Done,
                 centered; the reader hides while it counts down, and
                 the panel returns to the demo at zero. -->
            <StackPanel x:Name="CountdownGrid" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xEC32;" FontSize="32" Foreground="Gray" HorizontalAlignment="Center" />
                <TextBlock x:Name="CountdownTitleText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="CountdownText" FontSize="56" FontWeight="Bold" FontFamily="Consolas"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Back to Fast Read Lite when the timer ends." FontSize="12" Foreground="Gray"
                           HorizontalAlignment="Center" />
                <Button Content="Done" Click="OnCountdownDoneClicked" HorizontalAlignment="Center" Margin="0,8,0,0"
                        BorderBrush="#0078D4" BorderThickness="1" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
