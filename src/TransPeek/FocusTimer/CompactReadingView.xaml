<UserControl
    x:Class="TransPeek.FocusTimer.CompactReadingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fastread="using:TransPeek.FastRead">

    <!-- Lite Fast Read reader (feature/focus-timer-decor, mac parity:
         CompactReadingView in PanelFastReadView.swift): the same
         RsvpReaderViewModel as the Fast Read window, rendered compact
         for panel right — and for the Rest window. Playing shows only
         the focus line (+ the book page when the context display is
         Always) and the hint; paused adds the top bar, the progress
         bar and the transport. The top bar has the same four pickers
         as the window's control row (Speed / Focus size / Context
         size / Words at once) + Settings + "?" at the top-right, even
         at the small size (Manh 2026-11-20, 07:54 — the small frame
         still has room). At full size (width >= 540) the controls row
         also shows the Reading time (left) and the hint (right), like
         the window. The book page (pause context) pins the focus line
         at the vertical center with the before-text above and the
         after-text below — same words as the window's pause context,
         laid out like mac's bookPage. Glyphs (Segoe Fluent Icons,
         verified on Microsoft Learn): Settings E713, X E711, Restart
         E72C, Rewind EB9E, Play E768, Pause E769, Forward EB9D,
         Maximize E922. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top bar (paused only): 4 pickers tight (6 px, so they fit
             the 420 panel width) + Settings + "?" at the right. -->
        <Grid x:Name="TopBarGrid" Grid.Row="0" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ComboBox x:Name="WpmCombo" Width="80" SelectionChanged="OnWpmChanged" VerticalAlignment="Center"
                          ToolTipService.ToolTip="Reading speed" />
                <ComboBox x:Name="FocusSizeCombo" Width="72" SelectionChanged="OnFocusSizeChanged" VerticalAlignment="Center"
                          ToolTipService.ToolTip="Focus size">
                    <ComboBoxItem Content="40" Tag="40" />
                    <ComboBoxItem Content="48" Tag="48" />
                    <ComboBoxItem Content="56" Tag="56" />
                    <ComboBoxItem Content="64" Tag="64" />
                    <ComboBoxItem Content="72" Tag="72" />
                    <ComboBoxItem Content="80" Tag="80" />
                    <ComboBoxItem Content="88" Tag="88" />
                    <ComboBoxItem Content="96" Tag="96" />
                    <ComboBoxItem Content="104" Tag="104" />
                    <ComboBoxItem Content="110" Tag="110" />
                    <ComboBoxItem Content="120" Tag="120" />
                    <ComboBoxItem Content="140" Tag="140" />
                    <ComboBoxItem Content="160" Tag="160" />
                    <ComboBoxItem Content="200" Tag="200" />
                    <ComboBoxItem Content="250" Tag="250" />
                    <ComboBoxItem Content="300" Tag="300" />
                    <ComboBoxItem Content="350" Tag="350" />
                    <ComboBoxItem Content="400" Tag="400" />
                    <ComboBoxItem Content="450" Tag="450" />
                </ComboBox>
                <ComboBox x:Name="ContextSizeCombo" Width="72" SelectionChanged="OnContextSizeChanged" VerticalAlignment="Center"
                          ToolTipService.ToolTip="Context size">
                    <ComboBoxItem Content="25%" Tag="25" />
                    <ComboBoxItem Content="30%" Tag="30" />
                    <ComboBoxItem Content="35%" Tag="35" />
                    <ComboBoxItem Content="40%" Tag="40" />
                    <ComboBoxItem Content="50%" Tag="50" />
                    <ComboBoxItem Content="60%" Tag="60" />
                    <ComboBoxItem Content="75%" Tag="75" />
                    <ComboBoxItem Content="100%" Tag="100" />
                </ComboBox>
                <ComboBox x:Name="ChunkCombo" Width="60" SelectionChanged="OnChunkChanged" VerticalAlignment="Center"
                          ToolTipService.ToolTip="Words at once">
                    <ComboBoxItem Content="1" Tag="1" />
                    <ComboBoxItem Content="2" Tag="2" />
                    <ComboBoxItem Content="3" Tag="3" />
                    <ComboBoxItem Content="4" Tag="4" />
                    <ComboBoxItem Content="5" Tag="5" />
                    <ComboBoxItem Content="6" Tag="6" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="SettingsButton" Padding="6,4" ToolTipService.ToolTip="Reading settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <Button.Flyout>
                        <Flyout x:Name="SettingsFlyout">
                            <StackPanel Spacing="8" Width="260">
                                <TextBlock Text="Color Scheme" FontSize="14" FontWeight="SemiBold" />
                                <ComboBox x:Name="ColorSchemeCombo" SelectionChanged="OnColorSchemeChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Black on White" Tag="Light" />
                                    <ComboBoxItem Content="White on Black" Tag="Dark" />
                                </ComboBox>
                                <TextBlock Text="Show context around focus word" FontSize="14" FontWeight="SemiBold" />
                                <ComboBox x:Name="ContextDisplayCombo" SelectionChanged="OnContextDisplayChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Always" Tag="Always" />
                                    <ComboBoxItem Content="Only show when paused" Tag="Paused" />
                                    <ComboBoxItem Content="Never" Tag="Never" />
                                </ComboBox>
                                <TextBlock Text="Reading Style" FontSize="14" FontWeight="SemiBold" />
                                <ComboBox x:Name="ReadingStyleCombo" SelectionChanged="OnReadingStyleChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="RSVP Focus" Tag="RsvpFocus" />
                                    <ComboBoxItem Content="Basic Reading" Tag="BasicReading" />
                                </ComboBox>
                                <ToggleSwitch x:Name="HighlightToggle" Header="Highlight current line"
                                              Toggled="OnHighlightToggled"
                                              ToolTipService.ToolTip="Highlight the current line in the Basic Reading style" />
                                <Button Content="Reset to default" Click="OnResetClicked"
                                        ToolTipService.ToolTip="Reset speed, focus size, context size and context display to their defaults" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="HotkeysButton" Padding="6,4" ToolTipService.ToolTip="Hotkeys">
                    <TextBlock Text="?" FontSize="13" FontWeight="SemiBold" />
                    <Button.Flyout>
                        <Flyout x:Name="HotkeysFlyout">
                            <StackPanel Spacing="6" Width="240">
                                <TextBlock Text="Hotkeys" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Grid>
                                    <TextBlock Text="Space" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                    <TextBlock Text="Play / Pause" Foreground="Gray" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="← / →" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                    <TextBlock Text="Step one word" Foreground="Gray" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="↑ / ↓" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                    <TextBlock Text="Speed ±50 WPM" Foreground="Gray" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="R" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                    <TextBlock Text="Restart" Foreground="Gray" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Esc" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                    <TextBlock Text="Close reading" Foreground="Gray" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Reading area: the focus line pinned at the vertical center
             (the * / Auto / * rows keep it centered when the book page
             is off), with the before-text above and the after-text below
             when the context shows. Wheel over it changes the focus
             size (5pt per tick, NO cap — Manh 2026-11-20, 07:02). -->
        <Grid x:Name="ReadingAreaGrid" Grid.Row="1" Background="Transparent" PointerWheelChanged="OnReadingWheelChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="BeforeTextBlock" Grid.Row="0" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       VerticalAlignment="Bottom" Visibility="Collapsed" />
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Rectangle Width="2" Height="16" Fill="#C8C8C8" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="WordTextBlock" FontSize="110" TextAlignment="Center">
                    <Run x:Name="LeftRun" /><Run x:Name="PivotRun" Foreground="#F6861F" /><Run x:Name="RightRun" />
                </TextBlock>
                <Rectangle Width="2" Height="16" Fill="#C8C8C8" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
            <TextBlock x:Name="AfterTextBlock" Grid.Row="2" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       VerticalAlignment="Top" Visibility="Collapsed" />
        </Grid>

        <!-- Style 2 page (feature/fastread-speaker-style2): the
             scrollable page replaces the RSVP reading area in the same
             row — the control shows/hides itself by ReadingStyle. -->
        <fastread:Style2ReadingView x:Name="Style2View" Grid.Row="1" HorizontalPadding="12" Visibility="Collapsed" />

        <!-- Hint while playing (the only control affordance — the
             buttons stay hidden until pause, like mac). -->
        <TextBlock x:Name="HintTextBlock" Grid.Row="2" Margin="0,8,0,0"
                   Text="Space play/pause • ←/→ step • ↑/↓ speed • Swipe ↑/↓ font size"
                   FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Visibility="Collapsed" />

        <!-- Progress (paused only): seek slider + status. -->
        <Grid x:Name="ProgressGrid" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="ProgressSlider" Minimum="0" ValueChanged="OnProgressChanged" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="13" Foreground="Gray" Margin="12,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- Controls (paused only): X / Restart / Rewind / Play /
             Forward / Maximize, centered. At full size the Reading
             time sits left and the hint right, like the window. -->
        <Grid x:Name="ControlsGrid" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ReadingTimeText" Grid.Column="0" FontSize="12" Foreground="Gray"
                       VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="CloseButton" Padding="8,4" Click="OnCloseClicked" ToolTipService.ToolTip="Close reading (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="16" />
                </Button>
                <Button x:Name="RestartButton" Padding="8,4" Click="OnRestartClicked" ToolTipService.ToolTip="Restart from the beginning (R)">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" />
                </Button>
                <Button x:Name="SpeakerButton" Padding="8,4" Click="OnSpeakerClicked"
                        PointerEntered="OnSpeakerPointerEntered" PointerExited="OnSpeakerPointerExited"
                        ToolTipService.ToolTip="Sound off — click to hear the reading">
                    <FontIcon x:Name="SpeakerIcon" Glyph="&#xE74F;" FontSize="16" />
                </Button>
                <Button x:Name="PlayPauseButton" Padding="8,4" Click="OnPlayPauseClicked" ToolTipService.ToolTip="Play / Pause (Space)">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="16" />
                </Button>
                <Button x:Name="RewindButton" Padding="8,4" Click="OnRewindClicked" ToolTipService.ToolTip="Previous word (←)">
                    <FontIcon Glyph="&#xEB9E;" FontSize="16" />
                </Button>
                <Button x:Name="FastForwardButton" Padding="8,4" Click="OnFastForwardClicked" ToolTipService.ToolTip="Next word (→)">
                    <FontIcon Glyph="&#xEB9D;" FontSize="16" />
                </Button>
                <Button x:Name="MaximizeButton" Padding="8,4" Click="OnMaximizeClicked" ToolTipService.ToolTip="Maximize panel">
                    <FontIcon Glyph="&#xE922;" FontSize="16" />
                </Button>
            </StackPanel>
            <TextBlock x:Name="SideHintText" Grid.Column="2" FontSize="12" Foreground="Gray"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                       Text="Space play/pause • ←/→ step • ↑/↓ speed" />
        </Grid>

        <!-- Completion (paused + finished, mac §14.5): at full size the
             full congratulations sentence, at the small size just
             "Congratulations!" — mac shows the sentence + share
             full-size only. The share row below it (next row) shares
             the real stats of the finished read. -->
        <TextBlock x:Name="CompletionText" Grid.Row="5" Text="Congratulations!" FontSize="13" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" />
        <StackPanel x:Name="CompletionShareRowPanel" Grid.Row="6" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" />

        <!-- Voice panel (feature/fastread-speaker-style2): the voice
             picker + speed, as an in-tree overlay above the transport
             — NOT a Flyout/Popup, so clicking the speaker toggles the
             sound at once instead of dismissing a popup first (mac
             CI314 bug 2). Same contents as the reader window's panel;
             the voice picks share the Settings → TTS keys, the speed
             shares SpeechRate. -->
        <Border x:Name="VoicePanel" Grid.RowSpan="7" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,56" Width="300" Padding="12" CornerRadius="8" Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1"
                PointerEntered="OnVoicePanelPointerEntered" PointerExited="OnVoicePanelPointerExited">
            <StackPanel Spacing="8">
                <TextBlock Text="Voice" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="English voice" FontSize="13" />
                <ComboBox x:Name="EnglishVoiceCombo" SelectionChanged="OnEnglishVoiceChanged" HorizontalAlignment="Stretch" />
                <TextBlock Text="Vietnamese voice" FontSize="13" />
                <ComboBox x:Name="VietnameseVoiceCombo" SelectionChanged="OnVietnameseVoiceChanged" HorizontalAlignment="Stretch" />
                <Grid>
                    <TextBlock Text="Speed" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock x:Name="SpeedValueText" Text="1.0x" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Slider x:Name="SpeedSlider" Minimum="0.6" Maximum="4" StepFrequency="0.1" ValueChanged="OnSpeedChanged" />
                <TextBlock Text="Applies to Windows system voices. Speed takes effect from the next chunk or line."
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
