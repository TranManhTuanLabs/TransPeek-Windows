<Window
    x:Class="TransPeek.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Border CornerRadius="8" Background="#CC1F1F1F" Padding="14,8">
            <TextBlock x:Name="MessageText" Foreground="White" FontSize="13" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
