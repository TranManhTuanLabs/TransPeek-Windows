<UserControl
    x:Class="TransPeek.Views.DictionaryBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Horizontal scroll like the mac DictionaryBarView: many links scroll
         instead of overflowing / being cut off. -->
    <ScrollViewer x:Name="BarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="LinksPanel" Orientation="Horizontal" Spacing="6" />
    </ScrollViewer>
</UserControl>
