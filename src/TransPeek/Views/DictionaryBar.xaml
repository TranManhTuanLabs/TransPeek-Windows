<UserControl
    x:Class="TransPeek.Views.DictionaryBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Horizontal scroll like the mac DictionaryBarView: many links scroll
         instead of overflowing / being cut off.
         Bottom padding on the content: WinUI scrollbars overlay the
         content, so without it the bar covers the bottom half of the
         links (0.1.3.51 test). The padding is inside the scrollable
         content, so the buttons sit fully above the bar. -->
    <ScrollViewer x:Name="BarScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="LinksPanel" Orientation="Horizontal" Spacing="6" Padding="0,0,0,16" />
    </ScrollViewer>
</UserControl>
