<Window
    x:Class="TransPeek.Views.TriggerIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 32 px window with a 30 px circle — mac parity (TriggerIconPanel:
         32 pt panel, 30 pt circle inset 1 pt; see the link Manh asked
         for: Sources/UI/TriggerIcon/TriggerIconPanel.swift). The mark is
         a port of the mac's SF Symbol "character.bubble": a speech-bubble
         outline with the letter "A" inside (Manh 2026-11-14 — the plain
         "A" in the circle still looked wrong, so the mac bubble was
         ported; the background stays WHITE as it is now, not the mac's
         controlBackgroundColor). Clicking switches the mark to a speaker
         glyph (the visual state for the listen/TTS mode; TTS audio
         itself is NOT built yet — planned M2, after mac is stable). -->
    <Grid Background="Transparent">
        <Border x:Name="IconBorder" Width="30" Height="30" CornerRadius="15"
                Background="White" BorderBrush="#C8C8C8" BorderThickness="1">
            <Grid>
                <!-- Bubble mark (mac character.bubble): bubble outline
                     drawn as one Path (rounded rect + tail), "A" inside. -->
                <Viewbox x:Name="BubbleMark" Width="22" Height="22"
                         HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="M 6,3 L 18,3 Q 21,3 21,6 L 21,12 Q 21,15 18,15 L 12,15 L 10,20 L 8,15 L 6,15 Q 3,15 3,12 L 3,6 Q 3,3 6,3 Z"
                              Stroke="#1A1A1A" StrokeThickness="1.2" Fill="Transparent" />
                        <TextBlock Text="A" FontSize="8" FontWeight="Bold" Foreground="#1A1A1A"
                                   Canvas.Left="9" Canvas.Top="5" />
                    </Canvas>
                </Viewbox>
                <FontIcon x:Name="SpeakerMark" Glyph="&#xE7F5;" FontSize="16" Foreground="#1A1A1A"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
