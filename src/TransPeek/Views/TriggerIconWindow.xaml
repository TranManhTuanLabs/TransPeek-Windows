<Window
    x:Class="TransPeek.Views.TriggerIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sizes come from the user settings (Manh 2026-11-21, mac parity):
         FloatIconSize (default 26 pt) for a selection, AutoShowFloatIconSize
         (default 24 pt) for a hovered block — the window is the setting,
         the circle 2 pt smaller, the glyphs scale with the circle (see
         ShowAt in the code-behind). The XAML values below are only the
         first-paint defaults; ShowAt re-applies the real sizes on every show.
         Translate-first icon (Manh 2026-11-20 18:09 — the "future idea" in
         docs/FEATURES/FLOAT_ICON.md §3, now approved; it replaces
         Style B's preview-the-next-click, Manh 2026-11-18): the icon's
         normal face is the plain A, so it has three marks, one visible
         at a time (see UpdateGlyph in the code-behind):
         - BubbleMark: speech bubble (Segoe Fluent Icons Message E8BD,
           verified on Microsoft Learn 2026-11-18), blue #0078D4 —
           BACKUP style only (Manh 2026-11-19): it used to be the
           "next click will Speak" preview, but the plain A is the
           normal icon now, and the speaker is the Alt preview. The
           element stays defined (Visibility Collapsed) so the style
           can be restored by using it in UpdateGlyph again. The old
           plain "A" lettermark (Manh 2026-11-14) is back as PlainAMark.
         - PlainAMark: the normal icon — a plain "A" (NOT bold,
           blue #0078D4, Style 1 — Manh 2026-11-19: Click=Listen shows
           a non-bold blue A, not the turmeric one), shown whenever
           nothing else applies, whatever Click is set to (hover means
           translate — that is the icon's primary job). Its size scales
           with the circle (see ShowAt).
         - APlusMark: custom-drawn Fast Read mark — bold "A"
           with a small bold "+" as a superscript at the A's
           top-right corner, turmeric #C7800D (rgb 0.78/0.50/0.05) so
           it reads on light and dark — Alt held while Click=Speak
           (Alt+click will Fast Read), and it also shows for 2.5s after
           any Fast Read trigger. Both sizes scale with the circle.
         - SpeakerMark: E767 Volume — blue #0078D4 (Manh 2026-11-20
           18:09 — the speaker is a highlight, not a dark glyph) —
           while speaking, and as the Alt preview when Alt+click will
           Speak (Click=FastRead) (Manh 2026-11-19: Alt+icon must
           change to the speaker, not the bubble).
         The circle stays white and does NOT follow system dark/light
         yet — that is planned for later. -->
    <Grid Background="Transparent">
        <Border x:Name="IconBorder" Width="30" Height="30" CornerRadius="15"
                Background="White" BorderBrush="#C8C8C8" BorderThickness="1">
            <Grid>
                <FontIcon x:Name="BubbleMark" Glyph="&#xE8BD;" FontSize="16" Foreground="#0078D4"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <!-- Plain A (Manh 2026-11-19): the normal icon again —
                     NOT bold, blue #0078D4 (Style 1) — the Click=Listen
                     idle icon is the blue A, not turmeric. -->
                <TextBlock x:Name="PlainAMark" Text="A" FontSize="15" FontWeight="Normal" Foreground="#0078D4"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <!-- A+ mark: two TextBlocks in a Grid (NOT one TextBlock
                     with two Runs — WinUI's Run has no BaselineAlignment;
                     that is a WPF-only property, and using it broke the
                     build #178 with WMC0011). The "+" sits at the A's
                     top-right corner via alignment + margin. -->
                <Grid x:Name="APlusMark" Visibility="Collapsed">
                    <TextBlock x:Name="APlusMarkA" Text="A" FontSize="15" FontWeight="Bold" Foreground="#C7800D"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock x:Name="APlusMarkPlus" Text="+" FontSize="8" FontWeight="Bold" Foreground="#C7800D"
                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,5,0" />
                </Grid>
                <!-- Speaker mark (click = listen/TTS mode): E767 Volume —
                     the Windows 11 system speaker WITH sound waves. The
                     plain cone E992 "Volume0" (no waves, Manh's first
                     pick 2026-11-14) renders off-center in the 30 px
                     circle — the cone sits left with empty space where
                     the waves would be — so Manh prefers the waves in
                     for balance (2026-11-14). E74F is Mute (speaker
                     with an X), not this. -->
                <FontIcon x:Name="SpeakerMark" Glyph="&#xE767;" FontSize="16" Foreground="#0078D4"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
