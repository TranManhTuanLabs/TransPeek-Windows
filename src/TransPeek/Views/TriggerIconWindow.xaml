<Window
    x:Class="TransPeek.Views.TriggerIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 32 px window with a 30 px circle — mac parity (TriggerIconPanel:
         32 pt panel, 30 pt circle inset 1 pt; see the link Manh asked
         for: Sources/UI/TriggerIcon/TriggerIconPanel.swift). The mark is
         the letter "A" (Manh 2026-11-14: keep "A", drop the Chinese
         character), 14 pt like the mac symbol. The mac bubble port
         (0.1.3.72, a XAML Path bubble outline with "A" inside) looked
         bad — shadowed and off-size — so it was reverted to the plain
         "A" (Manh 2026-11-14). Clicking switches the mark to a speaker
         glyph (the visual state for the listen/TTS mode; TTS audio
         itself is NOT built yet — planned M2, after mac is stable). -->
    <Grid Background="Transparent">
        <Border x:Name="IconBorder" Width="30" Height="30" CornerRadius="15"
                Background="White" BorderBrush="#C8C8C8" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="LetterMark" Text="A" FontSize="14" FontWeight="Bold" Foreground="#1A1A1A"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <!-- Speaker mark (click = listen/TTS mode): E992 Volume0 —
                     a plain speaker cone with NO sound waves, like the
                     Windows 11 system speaker (Manh 2026-11-14). The old
                     E7F5 "Speakers" had waves; Manh wants the cone alone.
                     E767 "Volume" is the system icon WITH waves. -->
                <FontIcon x:Name="SpeakerMark" Glyph="&#xE992;" FontSize="16" Foreground="#1A1A1A"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
