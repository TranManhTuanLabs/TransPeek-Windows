<Window
    x:Class="TransPeek.Views.TriggerIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 32 px circle like the mac trigger icon (TriggerIconPanel: 32 pt,
         controlBackgroundColor fill, separator border, "character.bubble"
         symbol). Windows has no SF Symbols, so the mark is the same
         "A 文" text as before, shrunk to fit the circle. -->
    <Grid Background="Transparent">
        <Border x:Name="IconBorder" Width="30" Height="30" CornerRadius="15"
                Background="White" BorderBrush="#C8C8C8" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="A" FontSize="13" FontWeight="Bold" Foreground="#1A1A1A" VerticalAlignment="Center" />
                <TextBlock Text="&#x6587;" FontSize="10" Foreground="#1A1A1A" VerticalAlignment="Center" Margin="0,1,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
