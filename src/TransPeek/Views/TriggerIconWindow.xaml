<Window
    x:Class="TransPeek.Views.TriggerIconWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 32 px window with a 30 px circle — mac parity (TriggerIconPanel:
         32 pt panel, 30 pt circle inset 1 pt; see the link Manh asked
         for: Sources/UI/TriggerIcon/TriggerIconPanel.swift). The mac
         shows the SF Symbol "character.bubble", not text — Windows has
         no SF Symbols, so the mark is the letter "A" (Manh 2026-11-14:
         keep "A", drop the Chinese character). The full mac icon (SF
         Symbol look) is NOT ported yet — later. -->
    <Grid Background="Transparent">
        <Border x:Name="IconBorder" Width="30" Height="30" CornerRadius="15"
                Background="White" BorderBrush="#C8C8C8" BorderThickness="1">
            <TextBlock Text="A" FontSize="13" FontWeight="Bold" Foreground="#1A1A1A"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
