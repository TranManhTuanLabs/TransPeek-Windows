<Window
    x:Class="TransPeek.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TransPeek.Views">

    <Grid x:Name="RootGrid">
        <NavigationView x:Name="NavView" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        SelectionChanged="OnSelectionChanged" PaneDisplayMode="Left">
        <NavigationView.MenuItems>
            <!-- Icons (Segoe Fluent Icons, like Windows 11 Settings):
                 General = Settings gear, Translation = Edit,
                 Dictionary = Dictionary/book, OCR = Scan, About = Info. -->
            <NavigationViewItem x:Uid="Settings.Nav.General" Content="General" Tag="General">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="Settings.Nav.Translation" Content="Translation" Tag="Translation">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="Settings.Nav.Dictionary" Content="Dictionary" Tag="Dictionary">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="Settings.Nav.Ocr" Content="OCR" Tag="OCR">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8FE;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Uid="Settings.Nav.About" Content="About" Tag="About">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" Margin="16" />
        </NavigationView>
        <!-- Drag handle on the pane's right edge (Manh 2026-11-14):
             NavigationView exposes OpenPaneLength but has no built-in
             grip, so this 8 px strip sits centered on the pane boundary
             and updates OpenPaneLength as it is dragged (see code-behind).
             Positioned by Margin.Left = OpenPaneLength - 4. The 2 px
             inner strip is the visible mark; the 8 px hit area plus the
             horizontal-resize cursor make it easy to grab. -->
        <local:ResizeHandle x:Name="PaneResizeHandle" Width="8"
                            HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            Background="Transparent"
                            PointerPressed="OnPaneResizePressed"
                            PointerMoved="OnPaneResizeMoved"
                            PointerReleased="OnPaneResizeReleased"
                            PointerCanceled="OnPaneResizeReleased">
            <Border Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                    Background="#33000000" />
        </local:ResizeHandle>
    </Grid>
</Window>
