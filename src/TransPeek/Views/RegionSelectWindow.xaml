<Window
    x:Class="TransPeek.Views.RegionSelectWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RootGrid is focusable (IsTabStop) so keyboard input reaches this
         window: v0.1 relied only on a KeyboardAccelerator, but a plain
         Grid never takes keyboard focus, so Esc did nothing and the user
         was trapped fullscreen with no button to click. There are now
         four independent ways out: Esc, right-click, the Cancel button,
         and Alt+F4 (window Closed completes the selection task).
         The dim is deliberately light (~15% black): the 40% dim hid the
         screen content the user needs to see to pick a region (0.1.3.47
         test). The hint sits on a dark chip so it stays readable on any
         background. -->
    <Grid x:Name="RootGrid" Background="#26000000" IsTabStop="True">
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRect" Stroke="White" StrokeThickness="2"
                       Fill="#22FFFFFF" Visibility="Collapsed" />
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                Background="#CC000000" CornerRadius="6" Padding="10,4">
            <TextBlock x:Uid="RegionSelect.Hint" Text="Drag to select the region to OCR — Esc / right-click / Cancel to exit"
                       Foreground="White" FontSize="15" FontWeight="SemiBold" />
        </Border>
        <Button x:Name="CancelButton" x:Uid="RegionSelect.Cancel" Content="✕ Cancel (Esc)"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                Padding="12,6" />
    </Grid>
</Window>
