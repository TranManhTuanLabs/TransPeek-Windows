<Window
    x:Class="TransPeek.Views.TranslatePanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TransPeek.Views">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title: app name centered, slogan on the line below (Manh
             2026-11-12). The whole title bar is the drag handle: the
             panel has no title bar of its own, so the row is declared a
             NATIVE caption region (see UpdateCaptionRegion) — the OS
             moves the window itself, left button only, smooth, exactly
             like the Settings window's title bar. The manual
             AppWindow.Move drag was jerky and fired for right/middle
             buttons too; the system move (SendMessage WM_NCLBUTTONDOWN)
             never engaged for this no-activate window. Texts come from
             AppInfo in code-behind. Background="Transparent"
             (0.1.3.54): without a background the StackPanel is only
             hit-testable on the text glyphs, so only a press exactly on
             the name started a drag — the empty area beside/below the
             text received nothing. A transparent brush makes the whole
             row (full width) the handle. The row holds only text (the
             gear button is in the header row below it), so the whole
             row is the drag region. -->
        <StackPanel x:Name="TitleBar" Grid.Row="0" Margin="0,0,0,6"
                    Background="Transparent" HorizontalAlignment="Stretch">
            <TextBlock x:Name="AppNameText" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" />
            <TextBlock x:Name="TaglineText" Foreground="Gray" FontSize="11" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Header: provider attribution on its OWN line ABOVE the
             pickers (Manh 2026-11-14 — it was below them in 0.1.3.70,
             he wants it above). Mac parity (LanguageBarView): changing
             a picker saves the setting and re-translates immediately.
             No close (X) button: Esc and click-outside already close
             the panel (Manh 2026-11-12). -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="2" Margin="0,0,0,8">
            <TextBlock x:Name="ProviderText" Foreground="Gray" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ComboBox x:Name="SourceLangCombo" Width="128"
                          SelectionChanged="OnSourceLangChanged" />
                <Button x:Name="SwapButton" Content="⇄" Padding="6,2" Click="OnSwapLanguages" />
                <ComboBox x:Name="TargetLangCombo" Width="128"
                          SelectionChanged="OnTargetLangChanged" />
            </StackPanel>
        </StackPanel>

        <!-- Source text: editable like the mac SourceInputView.
             Enter re-translates, Shift+Enter inserts a newline.
             No inline copy button here (Manh 2026-11-12): the actions
             row already has Copy source. -->
        <!-- AcceptsReturn is False on purpose: with AcceptsReturn the
             TextBox consumes Enter in its own OnKeyDown (inserts a
             newline, marks the event handled) BEFORE the app's KeyDown
             handler runs, so Enter only made a newline and never
             re-translated (0.1.3.68). Enter = translate again,
             Shift+Enter = newline — both handled in OnSourceKeyDown. -->
        <TextBox x:Name="SourceTextBox" Grid.Row="2" TextWrapping="Wrap"
                 AcceptsReturn="False" MaxHeight="120" Margin="0,0,0,4"
                 TextChanged="OnSourceTextChanged" SelectionChanged="OnSourceSelectionChanged"
                 KeyDown="OnSourceKeyDown" />
        <TextBlock Grid.Row="3" x:Uid="Panel.Hint" Text="Enter: translate again • Esc: close • Select text in the panel to look it up in the dictionary"
                   FontSize="11" Foreground="Gray" Margin="0,0,0,8" />

        <!-- Translation: read-only TextBox (not TextBlock) so the user can
             select words inside the translation to look them up, like mac. -->
        <TextBox x:Name="TranslationTextBox" Grid.Row="4" IsReadOnly="True"
                 TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                 Background="Transparent" FontSize="14"
                 SelectionChanged="OnTranslationSelectionChanged" />

        <!-- Actions: copy buttons left, Settings gear on the right
             (Manh 2026-11-12). -->
        <Grid Grid.Row="5" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="CopyButton" x:Uid="Panel.Copy" Content="Copy" />
                <Button x:Name="CopySourceButton" x:Uid="Panel.CopySource" Content="Copy source" />
                <Button x:Name="CopyTranslationButton" x:Uid="Panel.CopyTranslation" Content="Copy translation" Visibility="Collapsed" />
                <Button x:Name="OcrButton" x:Uid="Panel.CaptureOcr" Content="Capture OCR" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Pin (Manh 2026-11-14): keep the panel fixed and always
                     visible — while pinned, click-outside and Esc do NOT
                     hide it. Toggle again to unpin. Segoe MDL2 Pin E718. -->
                <ToggleButton x:Name="PinButton" Padding="6,2"
                              ToolTipService.ToolTip="Pin panel (keep it visible)"
                              Click="OnPinToggled">
                    <FontIcon Glyph="&#xE718;" FontSize="12" />
                </ToggleButton>
                <Button x:Name="SettingsButton" Padding="6,2" Margin="8,0,0,0"
                        ToolTipService.ToolTip="Settings" Click="OnOpenSettings">
                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Dictionary links -->
        <local:DictionaryBar x:Name="DictionaryBarControl" Grid.Row="6" />

        <!-- Footer: GitHub repo link centered, dimmed build number right. -->
        <Grid Grid.Row="7" Margin="0,8,0,0">
            <HyperlinkButton x:Name="GithubLink" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="16" Height="16" CornerRadius="3" Background="White" VerticalAlignment="Center">
                        <Image x:Name="GithubMarkFooterImage" Width="16" Height="16" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="GitHub" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </HyperlinkButton>
            <TextBlock x:Name="FooterBuildText" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />
        </Grid>
    </Grid>
</Window>
