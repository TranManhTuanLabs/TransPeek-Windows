<Window
    x:Class="TransPeek.Views.TranslatePanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TransPeek.Views"
    xmlns:focus="using:TransPeek.FocusTimer">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Embedded "?" shortcuts card (Manh 2026-11-18, mac
                 parity): its own Auto row above the provider card —
                 Collapsed it takes no height, so the layout is
                 unchanged while the card is hidden; open, it adds its
                 height (header + max ~240 of rows) and auto-fit grows
                 the panel for it. -->
            <RowDefinition Height="Auto" />
            <!-- Output card is the * row (Manh 2026-11-15 — vertical
                 resize, full Windows approach): when the user drags the
                 window taller the card stretches so the translation
                 fills the extra height instead of leaving white space
                 below the footer. The TranslationTextBox inside is
                 capped by MaxHeight (260) for auto-fit, and the cap is
                 raised in code when the user drags taller so it can
                 grow past 260 for long text; for short text the panel
                 snaps back to the content height on release
                 (PersistResizedSize), so the * row never shows empty
                 space. Collapsed, the row goes back to Auto (see
                 SetProviderCardExpanded) so it only takes the header
                 height and does not sit as a tall empty row. -->
            <RowDefinition x:Name="OutputCardRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Dots row (Manh 2026-11-17, chose 12:51): a NEW row, centered
                 below the GitHub icon in the footer — the panel is now 10
                 rows. A new Auto row adds its height (~20) to
                 ComputeMinPanelHeight, so the panel may open a little
                 taller than the old 450 — Manh approved the increase. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title: app name centered, slogan on the line below (Manh
             2026-11-12). The whole title bar is the drag handle: the
             panel has no title bar of its own, so the row is declared a
             NATIVE caption region (see UpdateCaptionRegion) — the OS
             moves the window itself, left button only, smooth, exactly
             like the Settings window's title bar. The manual
             AppWindow.Move drag was jerky and fired for right/middle
             buttons too; the system move (SendMessage WM_NCLBUTTONDOWN)
             never engaged for this no-activate window. Texts come from
             AppInfo in code-behind. Background="Transparent"
             (0.1.3.54): without a background the StackPanel is only
             hit-testable on the text glyphs, so only a press exactly on
             the name started a drag — the empty area beside/below the
             text received nothing. A transparent brush makes the whole
             row (full width) the handle. The row holds only text (the
             gear button is in the header row below it), so the whole
             row is the drag region. -->
        <!-- Wheel over the title bar switches tabs, but NOT via a XAML
             handler: this row is the native caption region (drag to
             move, see UpdateCaptionRegion), and the OS swallows XAML
             pointer input there — so the wheel is caught in the window
             subclass instead (WM_MOUSEWHEEL in MinSizeSubclassProc). -->
        <StackPanel x:Name="TitleBar" Grid.Row="0" Margin="0,0,0,16"
                    Background="Transparent" HorizontalAlignment="Stretch">
            <TextBlock x:Name="AppNameText" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Foreground="#0EA5E9" />
            <!-- Tagline (slogan): 12 pt — exactly 1 size smaller than the
                 app name (13 pt), not 2 (Manh 2026-11-14). At 11 pt it
                 read too small next to the name; the 1 pt gap keeps the
                 hierarchy without the sizes drifting far apart. (Mac
                 uses a 2 pt gap — 17/15 — but Manh wants 1 pt here.) -->
            <TextBlock x:Name="TaglineText" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" />
            <!-- Hint (Manh 2026-11-15, mirrors mac): third line under
                 the slogan — "Hover icon to translate, Click to
                 listen". A few pt smaller than the slogan and dimmer
                 (tertiary); the size is set in RefreshTopBarFontSize
                 (app name - 4 pt, like mac). -->
            <TextBlock x:Name="HintText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Source text: editable like the mac SourceInputView.
             Enter re-translates, Shift+Enter inserts a newline.
             No inline copy button here (Manh 2026-11-12): the actions
             row already has Copy source. -->
        <!-- AcceptsReturn is False on purpose: with AcceptsReturn the
             TextBox consumes Enter in its own OnKeyDown (inserts a
             newline, marks the event handled) BEFORE the app's KeyDown
             handler runs, so Enter only made a newline and never
             re-translated (0.1.3.68). Enter = translate again,
             Shift+Enter = newline — both handled in OnSourceKeyDown. -->
        <TextBox x:Name="SourceTextBox" Grid.Row="1" TextWrapping="Wrap"
                 AcceptsReturn="False" MaxHeight="120" Margin="0,0,0,4"
                 TextChanged="OnSourceTextChanged" SelectionChanged="OnSourceSelectionChanged"
                 KeyDown="OnSourceKeyDown" SizeChanged="OnSourceTextBoxSizeChanged" />
        <!-- Source speaker + Copy INSIDE the input box (Manh
             2026-11-15): the speaker overlays the input's
             bottom-right corner; the Copy button (renamed from "Copy
             source" to just "Copy", like mac's SourceInputView where
             Speak + Copy sit together on the right below the text)
             sits next to it. Both are in one StackPanel in the same
             cell as the TextBox, after it in XAML so they paint on
             top, and stay there as the input grows. Speak is first,
             Copy second (mac order). Speak uses the Windows system
             voices (SystemSpeechService) — click to listen, click
             again to stop. -->
        <StackPanel x:Name="SourceOverlayPanel" Grid.Row="1" Orientation="Horizontal" Spacing="4"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,8">
            <Button x:Name="SpeakSourceButton" Padding="8,4"
                    ToolTipService.ToolTip="Listen to source text"
                    Click="OnSpeakSourceClicked">
                <FontIcon Glyph="&#xE767;" FontSize="16" />
            </Button>
            <Button x:Name="CopySourceButton" x:Uid="Panel.CopySource" Content="Copy" Padding="8,4" />
        </StackPanel>
        <!-- Hint — MUST stay on ONE line at MinPanelWidth (400): this TextBlock
             wraps, and a 2-line hint grows the fixed rows by ~15px, which the
             * output row pays for by clipping the speaker row at the card's
             bottom edge (root cause of the covered-speaker bug, #160/#161).
             Keep the text short enough to fit on one line at 400px wide. -->
        <!-- Wheel over the hint row switches tabs too (Manh 2026-11-19):
             the row is wrapped in a transparent Grid so the whole full
             width hit-tests, not just the text glyphs. -->
        <Grid Grid.Row="2" Background="Transparent" Margin="0,0,0,8" PointerWheelChanged="OnTabSwitchWheel">
            <TextBlock x:Name="HintTextBlock" x:Uid="Panel.Hint" Text="Select a word, then click Dictionary to look it up"
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap" />
        </Grid>

        <!-- Language pickers + Capture OCR (Manh 2026-11-15): ABOVE
             the output, like mac's LanguageBarView (input -> language
             bar -> provider results). The Capture OCR button sits on
             the same row, at the right (it used to live in the
             Actions row at the bottom). Changing a picker saves the
             setting and re-translates immediately, like mac. No close
             (X) button: Esc and click-outside already close the panel
             (Manh 2026-11-12). Widths are tight by design (Manh
             2026-11-17): the pickers were 128 wide with Spacing 6 and
             the Capture button touched/covered the Target picker —
             the row is only ~396 wide at the default panel width, so
             the pickers are 112 (the longest label, "Auto Detect",
             still fits with room) and the gaps are 4, leaving ~40 of
             slack for the Capture button. -->
        <Grid x:Name="LanguageBarGrid" Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SourceLangCombo" Width="112" />
                <Button x:Name="SwapButton" Content="⇄" Padding="4,2" Click="OnSwapLanguages" />
                <AutoSuggestBox x:Name="TargetLangCombo" Width="112" />
            </StackPanel>
            <!-- Capture OCR border (Manh 2026-11-20 17:05–17:06):
                 a LIGHT blue edge (#0078D4 at 40%) so the button reads
                 as an action without the colour dominating the panel.
                 Blue = the translate/blue family (same blue as the
                 plain-A icon). Border only — the fill stays default. -->
            <Button x:Name="OcrButton" Grid.Column="1" x:Uid="Panel.CaptureOcr" Content="Capture OCR" VerticalAlignment="Center"
                    BorderBrush="#660078D4" BorderThickness="1" />
        </Grid>

        <!-- Embedded "?" shortcuts card (Manh 2026-11-18, mac parity):
             the "?" button in the Actions row toggles this card at the
             TOP of the output area, above the provider card — a plain
             section, not a provider card and not a popover (mac:
             ShortcutsTableView at the top of the output ScrollView;
             the old Flyout popover is gone). The provider stays below
             it; the rows scroll inside the card (MaxHeight 240) so the
             panel never grows past ~280 for it. The header button IS
             the whole top bar (like the panel-left card headers):
             click it — or the × at its right end, or "?" again — to
             hide the card. Built by the same BuildShortcutRows as the
             shortcuts tab, so the two can never drift apart. -->
        <Border x:Name="EmbeddedShortcutsCard" Grid.Row="4" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button x:Name="EmbeddedShortcutsHeaderButton" Grid.Row="0" Click="OnEmbeddedShortcutsHeaderClicked"
                        Background="Transparent" BorderThickness="0" Padding="8,6"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEDA7;" FontSize="13" Foreground="Gray" VerticalAlignment="Center" />
                            <TextBlock Text="Keyboard shortcuts" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE711;" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                    </Grid>
                </Button>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="240">
                    <StackPanel x:Name="EmbeddedShortcutsRowsPanel" Spacing="2" Margin="8,0,8,8" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Translation output (Manh 2026-11-15): one card per provider,
             like mac's ProviderResultCard. The header line IS the
             provider ("Google Translate") with a chevron button that
             expands/collapses the body — later providers each get their
             own card the same way. The body is a read-only TextBox (not
             TextBlock) so the user can select words inside the
             translation to look them up, like mac. The card fills the
             remaining panel space (the * row) and the text scrolls when
             it is long (mac grows the window to fit, then scrolls —
             see PopupPanelSizing.frameToFit; the window resize comes
             later, the card + scroll is the shape first). The speaker
             + Copy sit INSIDE the TextBox's bottom-right corner
             (overlay, like the input's — Manh 2026-11-17, #162), wired
             to the Windows system voices (SystemSpeechService). -->
        <Border x:Name="ProviderCardBorder" Grid.Row="5" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1" MinHeight="218"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button x:Name="ProviderCardHeaderButton" Grid.Row="0" Click="OnProviderCardHeaderClicked"
                        Background="Transparent" BorderThickness="0" Padding="8,6"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock x:Name="ProviderChevronText" Text="⌄" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProviderNameText" Text="Google Translate" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="ProviderStatusText" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border x:Name="ProviderCardBodyDivider" Grid.Row="1" BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Margin="8,0" />
                <TextBox x:Name="TranslationTextBox" Grid.Row="2" IsReadOnly="True" Margin="8,6,8,0"
                         TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0"
                         Background="Transparent" FontSize="14" MaxHeight="260" MinHeight="60"
                         SelectionChanged="OnTranslationSelectionChanged" />
                <!-- Speak + Copy INSIDE the TextBox (Manh 2026-11-17,
                     #162): back to the overlay in the TextBox cell
                     (same * row, after the TextBox in XAML so they
                     paint on top), like the input's and like #157.
                     #160 had moved them to their own Auto row below
                     the TextBox to dodge the covered-speaker bug, but
                     the real cause was the hint wrapping to 2 lines
                     (fixed in #161 — hint is 1 line now, so the card
                     is never squeezed and the overlay cannot be
                     clipped by the card edge). The overlay gives the
                     TextBox the full card height back (218-2-29-1 ≈
                     186 at minimum, was ≈146 with the extra row).
                     Margin 0,0,6,8 like the input's. The Copy here is
                     the translation copy; CopyButton shows in normal
                     mode and CopyTranslationButton in OCR mode
                     (UpdateCopyButtons toggles them, only one visible
                     at a time) — both labelled just "Copy". Speak
                     first, Copy second (mac order). -->
                <StackPanel x:Name="ProviderCardSpeakerRow" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,8" Spacing="4">
                    <Button x:Name="SpeakTranslationButton" Padding="8,4"
                            ToolTipService.ToolTip="Listen to translation"
                            Click="OnSpeakTranslationClicked">
                        <FontIcon Glyph="&#xE767;" FontSize="16" />
                    </Button>
                    <Button x:Name="CopyButton" x:Uid="Panel.Copy" Content="Copy" Padding="8,4" />
                    <Button x:Name="CopyTranslationButton" x:Uid="Panel.CopyTranslation" Content="Copy" Padding="8,4" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Actions (Manh 2026-11-15): Fast Read at the LEFT end (with
             text, like mac's Label "Fast Read"), then ? / Pin /
             Settings grouped at the right. The copy buttons moved
             next to their speaker icons (input Copy inside the input,
             translation Copy inside the output card) and Capture OCR
             moved up to the language row, like mac. Margin top is 0,
             not 8 (Manh 2026-11-17): the card above already has
             bottom margin 8, so a top margin 8 here made the gap
             above the buttons 16 while the gap below (to the
             dictionary links) was only 8 — the buttons sat visibly
             low. With top 0 both gaps are 8. -->
        <Grid x:Name="ActionsPanel" Grid.Row="6" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Fast Read (feature/fast-read-rsvp, Manh 2026-11-18):
                 open the RSVP reader with the text being translated.
                 Glyph E736 ReadingMode (Segoe Fluent Icons, verified
                 on Microsoft Learn 2026-11-17) + text "Fast Read".
                 Sits at the left end of the Actions row, like mac —
                 it leaves the panel (opens a separate window), so it
                 is not part of the "?" + Pin + Settings group. -->
            <!-- Fast Read border (Manh 2026-11-20 17:05–17:06): a LIGHT
                 ochre edge (#C7800D at 40%, the A+ colour) so the
                 button reads as an action without the colour
                 dominating the panel. Border only — fill stays
                 default, like Capture OCR above (blue there). -->
            <Button x:Name="FastReadButton" Grid.Column="0" Padding="6,2"
                    ToolTipService.ToolTip="Fast Read" Click="OnFastReadClicked"
                    BorderBrush="#66C7800D" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE736;" FontSize="12" />
                    <TextBlock Text="Fast Read" FontSize="12" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
            <!-- Shortcuts "?" (Manh 2026-11-18, mac parity): toggles
                 the shortcuts card embedded at the top of the output
                 area (EmbeddedShortcutsCard) — the old Flyout popover
                 is gone. The "?" sits BEFORE Settings (Manh's choice
                 17/11). While the card is open the "?" shows in the
                 accent colour. The Pin button moved to the dots row
                 (feature/focus-timer-decor, mac parity — one pin for
                 all 3 panels, at the left end of the dots row). -->
            <Button x:Name="ShortcutsButton" Padding="6,2" Click="OnShortcutsButtonClicked"
                    ToolTipService.ToolTip="Keyboard shortcuts">
                <TextBlock x:Name="ShortcutsButtonText" Text="?" FontSize="12" FontWeight="SemiBold" />
            </Button>
            <Button x:Name="SettingsButton" Padding="6,2"
                    ToolTipService.ToolTip="Settings" Click="OnOpenSettings">
                <FontIcon Glyph="&#xE713;" FontSize="12" />
            </Button>
            </StackPanel>
        </Grid>

        <!-- Dictionary links — wheel over this row also switches tabs
             (OnTabSwitchWheel, same as the top bar and the dots row). -->
        <local:DictionaryBar x:Name="DictionaryBarControl" Grid.Row="7" PointerWheelChanged="OnTabSwitchWheel" />

        <!-- Panel left — shortcuts (Manh 2026-11-18, tên gọi CHỐT:
             panel left = panel 1, shortcuts, tạm thời; panel center =
             panel 2, dịch, CHỐT; panel right = panel 3, Fast Read,
             tạm thời. Nói mồm có thể nói panel 1/2/3 hay panel dịch
             1/2/3). Hai card như mac: card "How the icon works" (trên)
             + card shortcuts (dưới). Bấm toàn thanh top của mỗi card
             là thu gọn/mở ra — không cần bấm riêng nút góc phải. Trạng
             thái thu gọn của card "How the icon works" được nhớ trong
             Settings (HowIconWorksCollapsed); card shortcuts mở lại
             mỗi lần vào tab. Spans rows 1-7 (the whole tab content
             area); the shortcuts card takes the leftover height and
             scrolls if the 10 rows do not fit. -->
        <!-- Panel left content scrolls as ONE list now (Manh
             2026-11-19, like mac): a single ScrollViewer holding the
             How card + shortcuts table + share row, instead of a
             3-row Grid with a fixed share row at the bottom. The
             share row used to be a fixed Auto row taking ~50pt from
             the shortcuts card — space the future focus/tomato/
             rest-eyes timer will need. Now it flows at the end of
             the scroll content (like mac's ScrollView): collapsing
             the cards leaves the empty space below for the timer. -->
        <ScrollViewer x:Name="ShortcutsTabPanel" Grid.Row="1" Grid.RowSpan="7" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- Card "How the icon works" (mac parity, FlowIntroCard):
                 the flow in one place — Hover icon to translate, Click
                 icon to listen, Alt + Click for Fast Read, and where to
                 swap Click and Alt + Click. The header button IS the
                 whole top bar (like the provider card header): click it
                 to collapse or expand the body. Title icon: Lightbulb
                 EA80 (Segoe Fluent Icons, verified on Microsoft Learn
                 2026-11-18 — mac uses cursorarrow.click, Windows has
                 no such glyph). -->
            <Border Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="HowIconWorksHeaderButton" Grid.Row="0" Click="OnHowIconWorksHeaderClicked"
                            Background="Transparent" BorderThickness="0" Padding="8,6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA80;" FontSize="13" Foreground="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="HowIconWorksChevronText" Text="⌄" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                            <TextBlock Text="How the icon works" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="HowIconWorksBody" Grid.Row="1" Margin="8,0,8,8" Spacing="2">
                        <TextBlock Text="Not just a translator — it improves your learning experience." FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="Hover icon" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="→" FontSize="13" Foreground="Gray" VerticalAlignment="Center" />
                            <TextBlock Text="Translate the selected text" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Click icon" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="→" FontSize="13" Foreground="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="HowClickActionText" Text="Listen — hear it read aloud" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Alt + Click" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="→" FontSize="13" Foreground="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="HowAltClickActionText" Text="Fast Read — read it faster" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Tip: swap Click and Alt + Click in Settings." FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Focus & Rest card (feature/focus-timer-decor, mac
                 parity: FocusTimerCard.swift sits between FlowIntroCard
                 and ShortcutsTableView in PopupView): the Pomodoro /
                 rest-eyes card, with its own header (Clock E917) and
                 collapsible body. It is a UserControl — the whole card
                 (chrome + body) lives in FocusTimerCard.xaml. -->
            <focus:FocusTimerCard x:Name="FocusTimerCardControl" />
            <!-- Card shortcuts: the same 10 rows as the embedded "?"
                 card, built in code (BuildShortcutRows) from the same
                 _shortcuts list as the embedded card, so the two can
                 never drift apart. Header button = whole top bar:
                 click it to close/open the card. Title icon:
                 KeyboardShortcut EDA7 (Segoe Fluent Icons, verified
                 on Microsoft Learn 2026-11-18). -->
            <Border CornerRadius="6" BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button x:Name="ShortcutsCardHeaderButton" Grid.Row="0" Click="OnShortcutsCardHeaderClicked"
                            Background="Transparent" BorderThickness="0" Padding="8,6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEDA7;" FontSize="13" Foreground="Gray" VerticalAlignment="Center" />
                            <TextBlock x:Name="ShortcutsCardChevronText" Text="⌄" FontSize="12" Foreground="Gray" VerticalAlignment="Center" />
                            <TextBlock Text="Keyboard shortcuts" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="ShortcutsCardBody" Grid.Row="1">
                        <StackPanel x:Name="ShortcutsTabRowsPanel" Spacing="2" Margin="8,0,8,8" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Share (Manh 2026-11-19, mirrors mac d414700): the same
                 row of share buttons as the Fast Read completion window
                 and About — no card around it, no Spacer pushing it to
                 the bottom. It is the LAST item in this scroll content
                 (like mac's ScrollView): when the 2 cards collapse the
                 space left below is reserved for a future focus timer,
                 and the share just flows after the shortcuts table. -->
            <StackPanel Margin="0,8,0,0" Spacing="4">
                <TextBlock Text="Share TransPeek" FontSize="11" Foreground="Gray" HorizontalAlignment="Center" />
                <StackPanel x:Name="LeftShareRowPanel" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" />
            </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Panel right — Fast Read lite (feature/focus-timer-decor,
             mac parity: PanelFastReadView.swift): the demo when nothing
             reads (with the focus preview and the "Run FastRead in"
             radios) and the CompactReadingView while a read is
             running. It is a UserControl — the whole tab lives in
             PanelFastReadView.xaml. The old "coming soon" placeholder
             is gone. -->
        <focus:PanelFastReadView x:Name="FastReadTabPanel" Grid.Row="1" Grid.RowSpan="7" Visibility="Collapsed"
                                 PointerWheelChanged="OnFastReadTabWheel" />

        <!-- Pending reminder banner (feature/focus-timer-decor, mac
             parity: PendingReminderBanner in PopupView, under the dots
             row): overlays the tab area on ALL three tabs — a reminder
             never steals the reading in progress. Its top edge sits
             right under the hint (Row 2), not over the source box
             (Manh 2026-11-21). The banner collapses itself when there
             is no pending reminder, so this overlay takes no space then. -->
        <Grid Grid.Row="3" Grid.RowSpan="5" VerticalAlignment="Top">
            <focus:PendingReminderBanner x:Name="ReminderBanner" />
        </Grid>

        <!-- Footer: GitHub repo link centered, dimmed build number right.
             Wheel over this row also switches tabs (OnTabSwitchWheel). -->
        <Grid Grid.Row="8" Margin="0,8,0,0" Background="Transparent" PointerWheelChanged="OnTabSwitchWheel">
            <HyperlinkButton x:Name="GithubLink" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Width="16" Height="16" CornerRadius="3" Background="White" VerticalAlignment="Center">
                        <Image x:Name="GithubMarkFooterImage" Width="16" Height="16" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="GitHub" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </HyperlinkButton>
            <TextBlock x:Name="FooterBuildText" Foreground="Gray" FontSize="11"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.7" />
        </Grid>

        <!-- Panel dots (Manh 2026-11-17, chose 12:51): a NEW row, centered
             below the GitHub icon in the footer — NOT in the footer row
             and NOT in the Actions row. A new Auto row adds its height
             (~20) to ComputeMinPanelHeight, so the panel may open a
             little taller than the old 450 — Manh approved the increase.
             Bottom margin 8 = ResizeStripThickness: the native resize
             strip owns the bottom 8 px of the window, so the dots sit
             fully above it and stay clickable. Dots are 8 px, 8 px
             apart; the selected dot is #0EA5E9, the others #C8C8C8
             (set in ShowTab). The row also has ‹ › arrows (Manh
             2026-11-18) to switch tabs by click, and the mouse wheel
             over the row switches tabs too (like mac) — PointerWheelChanged
             on the row Grid (Background Transparent so the whole row,
             not just the dots, is hit-testable). The same switch runs
             from the hint row and the whole bottom bar — DictionaryBar
             row down through the footer (GitHub icon + version) — and
             from the title bar too, via the window subclass (the title
             bar is the caption region, so XAML wheel never reaches it;
             see MinSizeSubclassProc). The throttle is shared, so
             scrolling across zones cannot double-switch.
             One long wheel gesture = one tab switch (Manh 2026-11-18):
             after a wheel switch the next 0.4s of wheel ticks are
             ignored, or a long scroll would flip through several tabs
             at once. No swipe — WinUI has no native swipe for a panel
             like this; that would be custom work. -->
        <Grid x:Name="TabDotsRow" Grid.Row="9" Background="Transparent" Margin="0,4,0,8" PointerWheelChanged="OnTabSwitchWheel">
            <!-- Pin (feature/focus-timer-decor, mac parity: the pin
                 sits at the left end of the dots row, 10 pt from the
                 edge, and pins ALL three panels — it moved here from
                 the Actions row, which only showed it on the center
                 tab). Pin E718. -->
            <ToggleButton x:Name="PinButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="10,0,0,0" Padding="6,2"
                          ToolTipService.ToolTip="Pin panel (keep it visible)"
                          Click="OnPinToggled">
                <!-- Pin rotation -30° tilted LEFT like mac (Manh
                     2026-11-27): +30° was the WRONG direction (and
                     blurry again — any rotation blurs, as predicted).
                     Rotate the opposite way: from +30°, 30° back to
                     straight (0°) + 30° more to tilt left = -30°.
                     If -30° is still blurry, rotation itself is the
                     problem and a sharp tilted pin needs a non-rotated
                     approach (different glyph / Path). RenderTransformOrigin
                     centers the rotation on the icon. -->
                <FontIcon Glyph="&#xE718;" FontSize="12" RenderTransformOrigin="0.5,0.5">
                    <FontIcon.RenderTransform>
                        <RotateTransform Angle="-30" />
                    </FontIcon.RenderTransform>
                </FontIcon>
            </ToggleButton>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="TabPrevButton" MinWidth="0" MinHeight="0" Padding="4,2" Background="Transparent" BorderThickness="0"
                        Click="OnTabPrevClicked" ToolTipService.ToolTip="Previous tab">
                    <FontIcon Glyph="&#xE76B;" FontSize="10" Foreground="Gray" />
                </Button>
                <StackPanel x:Name="TabDotsPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="TabDotShortcuts" MinWidth="0" MinHeight="0" Width="8" Height="8" Padding="0" BorderThickness="0" CornerRadius="4" Background="#C8C8C8" Click="OnTabDotClicked" Tag="0" ToolTipService.ToolTip="Keyboard shortcuts" />
                    <Button x:Name="TabDotTranslate" MinWidth="0" MinHeight="0" Width="8" Height="8" Padding="0" BorderThickness="0" CornerRadius="4" Background="#0EA5E9" Click="OnTabDotClicked" Tag="1" ToolTipService.ToolTip="Translate" />
                    <Button x:Name="TabDotFastRead" MinWidth="0" MinHeight="0" Width="8" Height="8" Padding="0" BorderThickness="0" CornerRadius="4" Background="#C8C8C8" Click="OnTabDotClicked" Tag="2" ToolTipService.ToolTip="Fast Read" />
                </StackPanel>
                <Button x:Name="TabNextButton" MinWidth="0" MinHeight="0" Padding="4,2" Background="Transparent" BorderThickness="0"
                        Click="OnTabNextClicked" ToolTipService.ToolTip="Next tab">
                    <FontIcon Glyph="&#xE76C;" FontSize="10" Foreground="Gray" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Resize grip (Manh 2026-11-15 — like mac's ResizeGripView):
             three diagonal lines at the bottom-right corner, the
             classic resize indicator (mac draws the same 3 lines, 3 px
             apart, 1 px wide, in a subtle secondary colour). Decorative
             only — the actual drag is handled by the OS via the native
             resize strips (UpdateResizeRegions: BottomBorder +
             RightBorder), which also show the resize cursor there.
             It sits FLUSH against the window's bottom-right corner
             (Manh 2026-11-16): the negative margin (-11) cancels the
             root Grid's 12 px padding, so the 12x12 grip ends 1 px
             from the edge, inside the 8 px native resize strip — the
             cursor turns to resize as soon as the mouse reaches the
             lines, instead of the user having to travel a further
             12 px to the corner. The footer build text has NO right
             margin (Manh 2026-11-16): its right edge lines up with the
             Settings icon above it and the output card's right edge,
             all at the content edge — the 1 px corner touch with the
             grip is negligible. Replaces the single "↘" arrow, which
             read as a plain arrow rather than a resize grip. -->
        <Canvas Grid.RowSpan="10" Width="12" Height="12"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,-11,-11" IsHitTestVisible="False">
            <Line X1="3" Y1="12" X2="12" Y2="3"
                  Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1" />
            <Line X1="6" Y1="12" X2="12" Y2="6"
                  Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1" />
            <Line X1="9" Y1="12" X2="12" Y2="9"
                  Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="1" />
        </Canvas>
    </Grid>
</Window>
