<Page
    x:Class="TransPeek.Views.SettingsPages.TtsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <!-- Service (mac audio tab, "Service"): which TTS engine.
                 Only the Windows system voices for now. -->
            <TextBlock x:Uid="Settings.Tts.Service" Text="Service" FontWeight="SemiBold" />
            <ComboBox x:Name="TtsServiceCombo" x:Uid="Settings.Tts.TtsService" Header="TTS Service"
                      SelectionChanged="OnServiceChanged">
                <ComboBoxItem x:Uid="Settings.Tts.SystemBuiltIn" Content="System built-in" Tag="system" />
            </ComboBox>
            <TextBlock x:Uid="Settings.Tts.ServiceNote" Text="System built-in, no configuration needed."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <!-- Preferences (mac audio tab, "Preferences"). No "target
                 accent" row here (Manh 2026-11-16): the per-language
                 voice pickers in Voices below already cover it. -->
            <TextBlock x:Uid="Settings.Tts.Preferences" Text="Preferences" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ComboBox x:Name="EnglishAccentCombo" x:Uid="Settings.Tts.EnglishAccent" Header="English Accent"
                      SelectionChanged="OnEnglishAccentChanged" />
            <ComboBox x:Name="SpeechRateCombo" x:Uid="Settings.Tts.SpeechRate" Header="Default Speech Rate"
                      SelectionChanged="OnSpeechRateChanged">
                <ComboBoxItem Content="0.5x" Tag="0.5" />
                <ComboBoxItem Content="0.75x" Tag="0.75" />
                <ComboBoxItem Content="1x" Tag="1" />
                <ComboBoxItem Content="1.25x" Tag="1.25" />
                <ComboBoxItem Content="1.5x" Tag="1.5" />
                <ComboBoxItem Content="2x" Tag="2" />
            </ComboBox>
            <ToggleSwitch x:Name="AutoPlaySourceToggle" x:Uid="Settings.Tts.AutoPlaySource" Header="Auto-play source text"
                          OnContent="On" OffContent="Off"
                          Toggled="OnAutoPlaySourceToggled" />
            <ToggleSwitch x:Name="AutoPlayTranslationToggle" x:Uid="Settings.Tts.AutoPlayTranslation" Header="Auto-play translation result"
                          OnContent="On" OffContent="Off"
                          Toggled="OnAutoPlayTranslationToggled" />

            <!-- Voices (mac audio tab, "Voices (EN / VI)"): the exact
                 voice per language. "System default" = the voice
                 Windows picks for that language. -->
            <TextBlock x:Uid="Settings.Tts.Voices" Text="Voices (EN / VI)" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ComboBox x:Name="EnglishVoiceCombo" x:Uid="Settings.Tts.EnglishVoice" Header="English voice"
                      SelectionChanged="OnEnglishVoiceChanged" />
            <ComboBox x:Name="VietnameseVoiceCombo" x:Uid="Settings.Tts.VietnameseVoice" Header="Vietnamese voice"
                      SelectionChanged="OnVietnameseVoiceChanged" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Add voices (Manh 2026-11-16): ONE button only, and
                     it opens Language &amp; region — NOT Narrator. The
                     old target (Accessibility → Narrator) was wrong:
                     TTS voices come from Windows language packs, so
                     adding a voice means adding its language here.
                     The separate "Open Windows Settings" button that
                     opened the same place was redundant, so it is
                     gone. -->
                <Button x:Name="AddVoicesButton" x:Uid="Settings.Tts.AddVoices" Content="Add voices" Click="OnAddVoices" />
                <Button x:Name="RefreshVoicesButton" x:Uid="Settings.Tts.RefreshVoices" Content="Refresh" Click="OnRefreshVoices" />
                <!-- All voices (Manh 2026-11-16): a SEPARATE list of
                     every installed voice — the EN / VI pickers above
                     show only their own language, so this button shows
                     the full list in one place (read-only, just to see
                     what Windows has). -->
                <Button x:Name="AllVoicesButton" x:Uid="Settings.Tts.AllVoices" Content="All voices" Click="OnShowAllVoices" />
            </StackPanel>
            <ListView x:Name="AllVoicesListView" MaxHeight="200" Visibility="Collapsed" SelectionMode="None" />
            <TextBlock x:Uid="Settings.Tts.LanguagePackNote" Text="Voices also come from Windows language packs. To add one, open Windows Settings → Time &amp; language → Language &amp; region → Add a language, then click Refresh to see it here."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <!-- Test: hear a voice before leaving Settings. -->
            <TextBlock x:Uid="Settings.Tts.Test" Text="Test" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBox x:Name="TestTextBox" x:Uid="Settings.Tts.TestText" Header="Test text" Text="Hello," />
            <ComboBox x:Name="TestLanguageCombo" x:Uid="Settings.Tts.TestLanguage" Header="Language">
                <ComboBoxItem Content="English" Tag="en" />
                <ComboBoxItem Content="Vietnamese" Tag="vi" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PlayTestButton" x:Uid="Settings.Tts.PlayTest" Content="Play Test" Click="OnPlayTest" />
                <Button x:Name="StopTestButton" x:Uid="Settings.Tts.StopTest" Content="Stop" Click="OnStopTest" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
