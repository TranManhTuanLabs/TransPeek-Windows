<Page
    x:Class="TransPeek.Views.SettingsPages.TranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <ComboBox x:Name="PrimaryProviderCombo" x:Uid="Settings.Translation.PrimaryProvider" Header="Primary provider"
                      SelectionChanged="OnPrimaryChanged" />
            <ComboBox x:Name="FallbackProviderCombo" x:Uid="Settings.Translation.FallbackProvider" Header="Fallback provider"
                      SelectionChanged="OnFallbackChanged" />
            <TextBlock x:Uid="Settings.Translation.FallbackNote" Text="When the primary provider fails, the app tries the fallback provider, then other enabled providers, and finally free Google Translate."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <ComboBox x:Name="SourceLanguageCombo" x:Uid="Settings.Translation.SourceLanguage" Header="Source language"
                      SelectionChanged="OnSourceLanguageChanged" />
            <ComboBox x:Name="TargetLanguageCombo" x:Uid="Settings.Translation.TargetLanguage" Header="Target language"
                      SelectionChanged="OnTargetLanguageChanged" />

            <TextBlock x:Uid="Settings.Translation.EnableProviders" Text="Enable / disable providers" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel x:Name="ProviderToggles" Spacing="4" />

            <TextBlock x:Uid="Settings.Translation.CustomEndpoint" Text="Custom OpenAI-compatible endpoint" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="CustomList" SelectionChanged="OnCustomSelected" MaxHeight="120" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Settings.Translation.AddOpenAi" Content="Add OpenAI" Click="OnAddOpenAi" />
                <Button x:Uid="Settings.Translation.AddDeepSeek" Content="Add DeepSeek" Click="OnAddDeepSeek" />
                <Button x:Uid="Settings.Translation.Delete" Content="Delete" Click="OnDeleteCustom" />
            </StackPanel>
            <TextBox x:Name="CustomNameBox" x:Uid="Settings.Translation.CustomName" Header="Name" LostFocus="OnCustomEdited" />
            <TextBox x:Name="CustomBaseUrlBox" x:Uid="Settings.Translation.CustomBaseUrl" Header="Base URL" LostFocus="OnCustomEdited" />
            <TextBox x:Name="CustomModelBox" x:Uid="Settings.Translation.CustomModel" Header="Model" LostFocus="OnCustomEdited" />
            <PasswordBox x:Name="CustomApiKeyBox" x:Uid="Settings.Translation.CustomApiKey" Header="API key" LostFocus="OnCustomEdited" />
            <TextBlock x:Uid="Settings.Translation.ApiKeyDebt" Text="DEBT v0.1: API keys are stored as plain text in settings.json (see README). They will move to Credential Locker later."
                       FontSize="12" Foreground="DarkOrange" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
