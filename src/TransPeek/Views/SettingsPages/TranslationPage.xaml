<Page
    x:Class="TransPeek.Views.SettingsPages.TranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <ComboBox x:Name="PrimaryProviderCombo" Header="Provider chính"
                      SelectionChanged="OnPrimaryChanged" />
            <ComboBox x:Name="FallbackProviderCombo" Header="Provider dự phòng"
                      SelectionChanged="OnFallbackChanged" />
            <TextBlock Text="Khi provider chính lỗi, app thử provider dự phòng, rồi các provider đang bật khác, cuối cùng là Google Translate miễn phí."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <ComboBox x:Name="SourceLanguageCombo" Header="Ngôn ngữ nguồn"
                      SelectionChanged="OnSourceLanguageChanged" />
            <ComboBox x:Name="TargetLanguageCombo" Header="Ngôn ngữ đích"
                      SelectionChanged="OnTargetLanguageChanged" />

            <TextBlock Text="Bật / tắt từng provider" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel x:Name="ProviderToggles" Spacing="4" />

            <TextBlock Text="Custom OpenAI-compatible endpoint" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ListView x:Name="CustomList" SelectionChanged="OnCustomSelected" MaxHeight="120" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Thêm OpenAI" Click="OnAddOpenAi" />
                <Button Content="Thêm DeepSeek" Click="OnAddDeepSeek" />
                <Button Content="Xóa" Click="OnDeleteCustom" />
            </StackPanel>
            <TextBox x:Name="CustomNameBox" Header="Tên" LostFocus="OnCustomEdited" />
            <TextBox x:Name="CustomBaseUrlBox" Header="Base URL" LostFocus="OnCustomEdited" />
            <TextBox x:Name="CustomModelBox" Header="Model" LostFocus="OnCustomEdited" />
            <PasswordBox x:Name="CustomApiKeyBox" Header="API key" LostFocus="OnCustomEdited" />
            <TextBlock Text="NỢ v0.1: API key lưu dạng text thường trong settings.json (xem README). Sẽ chuyển sang Credential Locker sau."
                       FontSize="12" Foreground="DarkOrange" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
