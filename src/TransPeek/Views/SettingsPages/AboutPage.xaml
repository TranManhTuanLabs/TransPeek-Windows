<Page
    x:Class="TransPeek.Views.SettingsPages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="TransPeek" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="Gray" />
            <TextBlock Text="Translate anywhere, peek instantly." FontSize="13" />

            <!-- Author + repo link -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71B;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="Tác giả:" VerticalAlignment="Center" />
                <HyperlinkButton x:Name="RepoLink" Content="TranManhTuanLabs/TransPeek-Windows"
                                 Click="OnRepoLinkClick" Padding="0" />
            </StackPanel>

            <!-- Release notes for the running version -->
            <StackPanel Spacing="2">
                <HyperlinkButton x:Name="ReleaseNotesLink" Click="OnReleaseNotesClick" Padding="0" />
                <TextBlock Text="Chỉ mở được khi bản này đã được phát hành trên GitHub."
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Update check (simple: check only, manual download/install) -->
            <TextBlock Text="Cập nhật" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckUpdatesButton" Content="Check for Updates" Click="OnCheckUpdatesClick" />
                <HyperlinkButton x:Name="DownloadUpdateButton" Visibility="Collapsed"
                                 Click="OnDownloadUpdateClick" Padding="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock Text="Bản v0.1 chỉ kiểm tra và mở trang tải — bạn tự tải file về và cài tay. Tự động tải + cài + mở lại (Velopack) sẽ có lúc phát hành."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <TextBlock Text="Giấy phép AGPL-3.0. Ý tưởng gốc từ MoePeek (cosZone) — bản Windows viết lại từ đầu bằng C#, mirror thiết kế và hành vi, không copy code Swift."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
