<Page
    x:Class="TransPeek.Views.SettingsPages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="TransPeek" FontSize="24" FontWeight="Bold" />
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="Gray" />
            <TextBlock x:Uid="Settings.About.Tagline" Text="Translate anywhere, peek instantly." FontSize="13" />

            <!-- GitHub mark (cat) + GitHub + repo link -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="4" Background="White" VerticalAlignment="Center">
                    <Image x:Name="GithubMarkImage" Width="20" Height="20" Stretch="Uniform" />
                </Border>
                <TextBlock Text="GitHub" VerticalAlignment="Center" />
                <HyperlinkButton x:Name="RepoLink" Content="TranManhTuanLabs/TransPeek-Windows"
                                 Click="OnRepoLinkClick" Padding="0" />
            </StackPanel>

            <!-- Release notes for the running version -->
            <StackPanel Spacing="2">
                <HyperlinkButton x:Name="ReleaseNotesLink" Click="OnReleaseNotesClick" Padding="0" />
                <TextBlock x:Uid="Settings.About.RequiresRelease" Text="Only opens once this build has been released on GitHub."
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Update check (simple: check only, manual download/install) -->
            <TextBlock x:Uid="Settings.About.Updates" Text="Updates" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckUpdatesButton" x:Uid="Settings.About.CheckUpdates" Content="Check for Updates" Click="OnCheckUpdatesClick" />
                <HyperlinkButton x:Name="DownloadUpdateButton" Visibility="Collapsed"
                                 Click="OnDownloadUpdateClick" Padding="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Uid="Settings.About.V01Note" Text="v0.1 only checks and opens the download page — you download the file and install it manually. Automatic download + install + relaunch (Velopack) will come at release time."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <TextBlock x:Uid="Settings.About.License" Text="AGPL-3.0 license. The original idea is from MoePeek (cosZone) — the Windows version is rewritten from scratch in C#, mirroring the design and behavior, not copying Swift code."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
