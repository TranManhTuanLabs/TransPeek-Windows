<Page
    x:Class="TransPeek.Views.SettingsPages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <!-- App icon + name + slogan (Manh 2026-11-12). -->
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="10" Background="White" VerticalAlignment="Center">
                    <Image x:Name="AppIconImage" Width="48" Height="48" Stretch="Uniform" />
                </Border>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="TransPeek" FontSize="24" FontWeight="Bold" />
                    <TextBlock x:Uid="Settings.About.Tagline" Text="Translate anywhere, peek instantly." FontSize="13" Foreground="Gray" />
                </StackPanel>
            </StackPanel>

            <!-- GitHub mark (cat) + repo link (one "GitHub" only: the
                 plain TextBlock next to the cat duplicated the link text,
                 Manh 2026-11-14). -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="4" Background="White" VerticalAlignment="Center">
                    <Image x:Name="GithubMarkImage" Width="20" Height="20" Stretch="Uniform" />
                </Border>
                <HyperlinkButton x:Name="RepoLink" Content="Github.com/TranManhTuanLabs"
                                 Click="OnRepoLinkClick" Padding="0" />
            </StackPanel>

            <!-- All releases (list page, not just this version's tag). -->
            <StackPanel Spacing="2">
                <HyperlinkButton x:Name="ReleaseNotesLink" Click="OnReleaseNotesClick" Padding="0" />
                <TextBlock x:Uid="Settings.About.AllReleases" Text="See every release, including preview builds."
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Update check (simple: check only, manual download/install) -->
            <TextBlock x:Uid="Settings.About.Updates" Text="Updates" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CheckUpdatesButton" x:Uid="Settings.About.CheckUpdates" Content="Check for Updates" Click="OnCheckUpdatesClick" />
                <HyperlinkButton x:Name="DownloadUpdateButton" Visibility="Collapsed"
                                 Click="OnDownloadUpdateClick" Padding="0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Uid="Settings.About.V01Note" Text="v0.1 only checks and opens the download page — you download the file and install it manually. Automatic download + install + relaunch (Velopack) will come at release time."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <TextBlock x:Uid="Settings.About.License" Text="AGPL-3.0 license. The original idea is from MoePeek (cosZone) — the Windows version is rewritten from scratch in C#, mirroring the design and behavior, not copying Swift code."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0" />

            <!-- Support (donate): the standard template (Manh
                 2026-11-13, mirrors mac About) — EN sentence + VI
                 sentence + the 3-line account block, then the two
                 buttons. The QR stays behind a button so About stays
                 compact; the account number can be copied directly. -->
            <TextBlock x:Uid="Settings.About.Support" Text="Support TransPeek" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
            <!-- The English + Vietnamese lines are one message: keep them
                 tight (Spacing 2), not a full line apart (0.1.3.64 test). -->
            <StackPanel Spacing="2">
                <TextBlock x:Uid="Settings.About.Support.Message" Text="If this app is useful to you, you can support the project by buying me a coffee!"
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                <TextBlock x:Uid="Settings.About.Support.MessageVi" Text="Nếu ứng dụng này hữu ích với bạn, bạn có thể ủng hộ dự án bằng một ly cà phê!"
                           FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="SupportAccountText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ShowQrButton" Click="OnShowQrClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8FE;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Uid="Settings.About.Support.ShowQr" Text="Show QR Code" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="CopyAccountButton" Click="OnCopyAccountClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="CopyAccountText" x:Uid="Settings.About.Support.CopyAccount" Text="Copy Account Number" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Restart: recovery when the app misbehaves (e.g. after an
                 OCR engine switch that crashes it, Manh 2026-11-14). The
                 tray menu has the same action, but the tray menu itself
                 is unreliable right now, so Settings needs one too. -->
            <Button x:Name="RestartButton" x:Uid="Settings.About.Restart" Content="Restart TransPeek"
                    Click="OnRestartClick" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
