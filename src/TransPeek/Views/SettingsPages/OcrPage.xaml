<Page
    x:Class="TransPeek.Views.SettingsPages.OcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <ComboBox x:Name="OcrProviderCombo" Header="OCR engine"
                      SelectionChanged="OnProviderChanged">
                <ComboBoxItem Content="Tesseract (best for Vietnamese)" Tag="tesseract" />
                <ComboBoxItem Content="Windows OCR (built-in)" Tag="windows-ocr" />
            </ComboBox>

            <TextBox x:Name="OcrLanguagesBox" Header="Ngôn ngữ OCR (BCP 47, cách nhau bằng dấu phẩy)"
                     LostFocus="OnLanguagesLostFocus" />

            <ComboBox x:Name="PostModeCombo" Header="Sau khi OCR"
                      SelectionChanged="OnPostModeChanged">
                <ComboBoxItem Content="OCR → dịch → panel" Tag="OpenPanel" />
                <ComboBoxItem Content="OCR → copy thẳng text gốc" Tag="CopyOnly" />
            </ComboBox>

            <ToggleSwitch x:Name="AutoCopyToggle" Header="Tự copy bản dịch sau OCR"
                          OnContent="Bật" OffContent="Tắt"
                          Toggled="OnAutoCopyToggled" />

            <TextBox x:Name="OcrHotkeyBox" Header="Phím tắt chụp vùng (vd: Control+Shift+S)"
                     LostFocus="OnHotkeyLostFocus" />
            <TextBlock x:Name="HotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <TextBlock Text="Tesseract language data" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock x:Name="TesseractStatusText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="InstalledCodesText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="DownloadVieButton" Content="Tải vie" Click="OnDownloadVie" />
                <Button x:Name="DownloadEngButton" Content="Tải eng" Click="OnDownloadEng" />
                <Button x:Name="DownloadBothButton" Content="Tải vie + eng" Click="OnDownloadBoth" />
            </StackPanel>
            <TextBlock x:Name="DownloadStatusText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock Text="Dữ liệu tải từ tessdata_best (GitHub) vào %LOCALAPPDATA%\TransPeek\tessdata. Windows OCR không cần tải gì thêm, nhưng tiếng Việt cần gói 'Vietnamese OCR' trong Settings Windows (Time &amp; language → Language → Vietnamese → Options)."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
