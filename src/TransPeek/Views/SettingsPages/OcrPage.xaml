<Page
    x:Class="TransPeek.Views.SettingsPages.OcrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <ComboBox x:Name="OcrProviderCombo" x:Uid="Settings.Ocr.Provider" Header="OCR engine"
                      SelectionChanged="OnProviderChanged">
                <ComboBoxItem x:Uid="Settings.Ocr.Tesseract" Content="Tesseract (best for Vietnamese)" Tag="tesseract" />
                <ComboBoxItem x:Uid="Settings.Ocr.WindowsOcr" Content="Windows OCR (built-in)" Tag="windows-ocr" />
            </ComboBox>

            <TextBox x:Name="OcrLanguagesBox" x:Uid="Settings.Ocr.Languages" Header="OCR languages (BCP 47, comma-separated)"
                     LostFocus="OnLanguagesLostFocus" />

            <ComboBox x:Name="PostModeCombo" x:Uid="Settings.Ocr.PostMode" Header="After OCR"
                      SelectionChanged="OnPostModeChanged">
                <ComboBoxItem x:Uid="Settings.Ocr.OpenPanel" Content="OCR → translate → panel" Tag="OpenPanel" />
                <ComboBoxItem x:Uid="Settings.Ocr.CopyOnly" Content="OCR → copy source text directly" Tag="CopyOnly" />
            </ComboBox>

            <ToggleSwitch x:Name="AutoCopyToggle" x:Uid="Settings.Ocr.AutoCopy" Header="Auto-copy translation after OCR"
                          OnContent="On" OffContent="Off"
                          Toggled="OnAutoCopyToggled" />

            <!-- Hotkey box REMOVED (Manh 2026-11-20): the OCR capture
                 hotkey lives in General ("OCR Screen Translate") and
                 edits the same OcrHotkey setting — this second box
                 here was a duplicate. -->
            <TextBlock x:Uid="Settings.Ocr.LanguageData" Text="Tesseract language data" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock x:Uid="Settings.Ocr.LanguageGuide" Text="Which languages do you usually use OCR for? Tick them below and download — OCR can only recognize a language after its data is downloaded." FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="TesseractStatusText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="InstalledCodesText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <!-- Download more languages (Manh 2026-11-15): tick the
                 languages to fetch, then Download. No "Download all"
                 button — files are large, so the user picks what they
                 need. The list is hardcoded (works offline); Refresh
                 fetches the live list from GitHub to find new ones.
                 The find box lives INSIDE the Expander, at the head of
                 the list (Manh 2026-11-16): placed outside it, the box
                 looked separate from the list it filters, and typing
                 in it did nothing visible while the Expander was
                 collapsed. The Expander starts expanded so the find
                 box is usable right away. -->
            <Expander x:Name="LanguagesExpander" Header="All Tesseract languages" IsExpanded="True">
                <StackPanel>
                    <TextBox x:Name="LanguageFindBox" x:Uid="Settings.Ocr.FindLanguage" Header="Find a language"
                             PlaceholderText="Type a name or code, e.g. French or fra"
                             TextChanged="OnLanguageFindChanged" Margin="0,0,0,8" />
                    <ListView x:Name="LanguagesListView" MaxHeight="220" SelectionMode="None" />
                </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="DownloadSelectedButton" x:Uid="Settings.Ocr.DownloadSelected" Content="Download selected" Click="OnDownloadSelected" />
                <Button x:Name="RefreshLanguagesButton" x:Uid="Settings.Ocr.RefreshLanguages" Content="Refresh" Click="OnRefreshLanguages" />
            </StackPanel>
            <TextBlock x:Name="SizeWarningText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="DownloadStatusText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Uid="Settings.Ocr.DataNote" Text="Data downloads from tessdata_best (GitHub) into %LOCALAPPDATA%\TransPeek\tessdata."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <TextBlock x:Uid="Settings.Ocr.WindowsLanguages" Text="Windows OCR languages" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock x:Name="WindowsOcrLanguagesText" FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <Button x:Name="OpenWindowsSettingsButton" x:Uid="Settings.Ocr.OpenWindowsSettings" Content="Open Windows Settings" Click="OnOpenWindowsSettings" />
            <TextBlock x:Uid="Settings.Ocr.WindowsLanguagesNote" Text="Windows OCR languages come from Windows, not from the app. To add one, open Windows Settings → Time &amp; language → Language &amp; region → Add a language, then tick 'Optical character recognition'."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
