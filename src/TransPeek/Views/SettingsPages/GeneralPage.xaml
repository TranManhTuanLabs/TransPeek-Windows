<Page
    x:Class="TransPeek.Views.SettingsPages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <ToggleSwitch x:Name="WatchSelectionToggle" x:Uid="Settings.General.WatchSelection" Header="Watch selection automatically"
                          OnContent="On" OffContent="Off"
                          Toggled="OnWatchSelectionToggled" />
            <TextBlock x:Uid="Settings.General.WatchSelectionHint" Text="When on, the trigger icon appears whenever you select text. When off, the app only responds to hotkeys and the tray menu."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <ComboBox x:Name="HoverDelayCombo" x:Uid="Settings.General.HoverDelay" Header="How long to hover before the panel opens"
                      SelectionChanged="OnHoverDelayChanged">
                <ComboBoxItem Content="300 ms" Tag="300" />
                <ComboBoxItem Content="500 ms" Tag="500" />
            </ComboBox>

            <NumberBox x:Name="AutoHideBox" x:Uid="Settings.General.AutoHide" Header="Trigger icon hides after (seconds)"
                       Minimum="1" Maximum="30" SpinButtonPlacementMode="Compact"
                       ValueChanged="OnAutoHideChanged" />

            <!-- Appearance (Manh 2026-11-15): a section INSIDE General,
                 NOT a separate tab — like mac's Sections in
                 GeneralSettingsView (Section "Appearance" with Text
                 Size, Section "Popup Panel" with AppName & Slogan Font
                 Size). Text Size > Popup Panel > App name & Slogan
                 Font Size. The slider sets the app-name size; the
                 tagline is always 1 pt smaller (applied by the panel).
                 Mac parity: same slider 12-24 (mac default 17,
                 Windows default 13). -->
            <TextBlock x:Uid="Settings.General.Appearance" Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock x:Uid="Settings.General.TextSize" Text="Text Size" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock x:Uid="Settings.General.PopupPanel" Text="Popup Panel" FontWeight="SemiBold" Margin="0,8,0,0" />
            <Slider x:Name="FontSizeSlider" x:Uid="Settings.General.FontSize" Header="App name &amp; Slogan Font Size"
                    Minimum="12" Maximum="24" StepFrequency="1"
                    ValueChanged="OnFontSizeChanged" />
            <TextBlock x:Name="FontSizeValueText" FontSize="12" Foreground="Gray" />

            <TextBlock x:Uid="Settings.General.HotkeyHint" Text="Click a hotkey box, then press the key combination — no typing needed. Esc cancels."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />

            <TextBox x:Name="TranslateHotkeyBox" x:Uid="Settings.General.TranslateHotkey" Header="Hotkey to open the translate panel (e.g. Control+Alt+T)"
                     GotFocus="OnHotkeyBoxGotFocus" KeyDown="OnHotkeyBoxKeyDown"
                     LostFocus="OnTranslateHotkeyLostFocus" />
            <TextBlock x:Name="HotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <TextBox x:Name="OcrHotkeyBox" x:Uid="Settings.General.OcrHotkey" Header="Hotkey for OCR from Screen (e.g. Control+Shift+S)"
                     GotFocus="OnHotkeyBoxGotFocus" KeyDown="OnHotkeyBoxKeyDown"
                     LostFocus="OnOcrHotkeyLostFocus" />
            <TextBlock x:Name="OcrHotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <!-- One hotkey per tray menu action (Manh 2026-11-12). -->
            <TextBox x:Name="ManualHotkeyBox" x:Uid="Settings.General.ManualHotkey" Header="Hotkey for Manual Translation (e.g. Control+Alt+M)"
                     GotFocus="OnHotkeyBoxGotFocus" KeyDown="OnHotkeyBoxKeyDown"
                     LostFocus="OnManualHotkeyLostFocus" />
            <TextBlock x:Name="ManualHotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <TextBox x:Name="ClipboardOcrHotkeyBox" x:Uid="Settings.General.ClipboardOcrHotkey" Header="Hotkey for OCR to clipboard (e.g. Control+Alt+C)"
                     GotFocus="OnHotkeyBoxGotFocus" KeyDown="OnHotkeyBoxKeyDown"
                     LostFocus="OnClipboardOcrHotkeyLostFocus" />
            <TextBlock x:Name="ClipboardOcrHotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <TextBox x:Name="SelectionHotkeyBox" x:Uid="Settings.General.SelectionHotkey" Header="Hotkey for Selection Translation (e.g. Control+Alt+S)"
                     GotFocus="OnHotkeyBoxGotFocus" KeyDown="OnHotkeyBoxKeyDown"
                     LostFocus="OnSelectionHotkeyLostFocus" />
            <TextBlock x:Name="SelectionHotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <TextBox x:Name="ScreenshotCopyHotkeyBox" x:Uid="Settings.General.ScreenshotCopyHotkey" Header="Hotkey for Screenshot Copy (e.g. Control+Alt+P)"
                     GotFocus="OnHotkeyBoxGotFocus" KeyDown="OnHotkeyBoxKeyDown"
                     LostFocus="OnScreenshotCopyHotkeyLostFocus" />
            <TextBlock x:Name="ScreenshotCopyHotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <TextBox x:Name="ScanHotkeyBox" x:Uid="Settings.General.ScanHotkey" Header="Hotkey for Scan Barcodes / QR Codes (e.g. Control+Alt+B)"
                     GotFocus="OnHotkeyBoxGotFocus" KeyDown="OnHotkeyBoxKeyDown"
                     LostFocus="OnScanHotkeyLostFocus" />
            <TextBlock x:Name="ScanHotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <TextBox x:Name="SettingsHotkeyBox" x:Uid="Settings.General.SettingsHotkey" Header="Hotkey to open Settings (e.g. Control+Alt+O)"
                     GotFocus="OnHotkeyBoxGotFocus" KeyDown="OnHotkeyBoxKeyDown"
                     LostFocus="OnSettingsHotkeyLostFocus" />
            <TextBlock x:Name="SettingsHotkeyErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <ToggleSwitch x:Name="LaunchAtLoginToggle" x:Uid="Settings.General.LaunchAtLogin" Header="Launch with Windows"
                          OnContent="On" OffContent="Off"
                          Toggled="OnLaunchAtLoginToggled" />
            <TextBlock x:Uid="Settings.General.RunKeyNote" Text="Writes to the Windows Run key (HKCU\Software\Microsoft\Windows\CurrentVersion\Run). No admin rights needed."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
            <TextBlock x:Name="LaunchErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />

            <TextBlock x:Uid="Settings.General.SettingsPath" Text="Settings are stored in %LOCALAPPDATA%\TransPeek\settings.json"
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
