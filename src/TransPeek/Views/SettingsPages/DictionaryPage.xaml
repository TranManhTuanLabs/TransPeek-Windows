<Page
    x:Class="TransPeek.Views.SettingsPages.DictionaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:TransPeek.Core.Dictionary">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <ListView x:Name="LinksList" SelectionChanged="OnLinkSelected" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:DictionaryLink">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind UrlTemplate}" FontSize="11" Foreground="Gray" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBox x:Name="LinkNameBox" Header="Tên (vd: Oxford)" />
            <TextBox x:Name="LinkTemplateBox" Header="URL template (phải chứa {word} hoặc {text})" />
            <TextBlock x:Name="LinkErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Thêm" Click="OnAddLink" />
                <Button Content="Cập nhật" Click="OnUpdateLink" />
                <Button Content="Xóa" Click="OnDeleteLink" />
            </StackPanel>

            <ComboBox x:Name="DisplayModeCombo" Header="Hiển thị ở bottom panel"
                      SelectionChanged="OnDisplayModeChanged">
                <ComboBoxItem Content="Icon + Text" Tag="IconAndText" />
                <ComboBoxItem Content="Chỉ icon" Tag="IconOnly" />
            </ComboBox>
            <TextBlock Text="Bấm vào link ở bottom panel sẽ mở trang từ điển trong trình duyệt mặc định. Icon lấy từ favicon của trang, lỗi thì hiện chữ cái đầu của tên."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
