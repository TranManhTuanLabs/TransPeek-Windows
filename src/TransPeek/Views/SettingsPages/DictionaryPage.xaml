<Page
    x:Class="TransPeek.Views.SettingsPages.DictionaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:TransPeek.Core.Dictionary">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <ListView x:Name="LinksList" SelectionChanged="OnLinkSelected" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:DictionaryLink">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind UrlTemplate}" FontSize="11" Foreground="Gray" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBox x:Name="LinkNameBox" x:Uid="Settings.Dictionary.LinkName" Header="Name (e.g. Oxford)" />
            <TextBox x:Name="LinkTemplateBox" x:Uid="Settings.Dictionary.LinkTemplate" Header="URL template (must contain {word} or {text})" />
            <TextBlock x:Name="LinkErrorText" FontSize="12" Foreground="Red" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Settings.Dictionary.Add" Content="Add" Click="OnAddLink" />
                <Button x:Uid="Settings.Dictionary.Update" Content="Update" Click="OnUpdateLink" />
                <Button x:Uid="Settings.Dictionary.Delete" Content="Delete" Click="OnDeleteLink" />
                <Button x:Uid="Settings.Dictionary.ResetDefaults" Content="Reset to Defaults" Click="OnResetDefaults" />
            </StackPanel>

            <ComboBox x:Name="DisplayModeCombo" x:Uid="Settings.Dictionary.DisplayMode" Header="Shown in the bottom panel"
                      SelectionChanged="OnDisplayModeChanged">
                <ComboBoxItem x:Uid="Settings.Dictionary.IconAndText" Content="Icon + Text" Tag="IconAndText" />
                <ComboBoxItem x:Uid="Settings.Dictionary.IconOnly" Content="Icon only" Tag="IconOnly" />
            </ComboBox>
            <TextBlock x:Uid="Settings.Dictionary.Note" Text="Clicking a link in the bottom panel opens the dictionary page in your default browser. The icon comes from the site's favicon; on error it shows the first letter of the name."
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
