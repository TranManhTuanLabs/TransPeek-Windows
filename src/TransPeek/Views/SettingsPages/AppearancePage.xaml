<Page
    x:Class="TransPeek.Views.SettingsPages.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Left">
            <!-- Text Size (Manh 2026-11-14): appearance settings live
                 here, not in General. The popup panel's top bar is the
                 only text-size target so far; more (e.g. panel body)
                 can join this section later. -->
            <TextBlock x:Uid="Settings.Appearance.TextSize" Text="Text Size" FontSize="16" FontWeight="SemiBold" />

            <TextBlock x:Uid="Settings.Appearance.PopupPanel" Text="Popup Panel" FontWeight="SemiBold" Margin="0,8,0,0" />
            <!-- App name & Slogan Font Size: the slider sets the app-name
                 size; the tagline is always 1 pt smaller (applied by the
                 panel). Mac parity: same slider 12-24 as mac's Text Size
                 (mac default 17, Windows default 13). The value label
                 below shows the app-name size; the tagline follows at -1. -->
            <Slider x:Name="FontSizeSlider" x:Uid="Settings.Appearance.FontSize" Header="App name &amp; Slogan Font Size"
                    Minimum="12" Maximum="24" StepFrequency="1"
                    ValueChanged="OnFontSizeChanged" />
            <TextBlock x:Name="FontSizeValueText" FontSize="12" Foreground="Gray" />
        </StackPanel>
    </ScrollViewer>
</Page>
